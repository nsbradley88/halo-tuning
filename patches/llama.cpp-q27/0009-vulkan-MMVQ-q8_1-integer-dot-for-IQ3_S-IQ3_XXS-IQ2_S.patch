diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
index 03c348bf9..cfbe00a16 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
@@ -584,3 +584,113 @@ FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
     return sum;
 }
 #endif
+
+#if defined(DATA_A_IQ3_S) || defined(DATA_A_IQ3_XXS) || defined(DATA_A_IQ2_S) || defined(DATA_A_IQ2_XS)
+// grid bytes g (all >= 1) with the 4 sign bits s applied: byte-wise two's complement negation, no carries
+int32_t iq3_signed_grid(const uint g, const uint s) {
+    const uint m = ((s & 0xF) * 0x00204081u) & 0x01010101u; // sign bit i -> bit 0 of byte i
+    return int32_t((g ^ (m * 0xFFu)) + m);
+}
+#endif
+
+#if defined(DATA_A_IQ3_S)
+FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
+    const uint ib = ib_a / 8;
+    const uint ib32 = ib_a % 8;
+
+    // one high index bit per grid index (8 per 32 values), one sign bit per value
+    const uint qh = uint(data_a_packed16[ib].qh[ib32 / 2]) >> ((ib32 & 1) * 8);
+    const uint signs = uint(data_a_packed16[ib].signs[ib32 * 2]) | (uint(data_a_packed16[ib].signs[ib32 * 2 + 1]) << 16);
+
+    int32_t q_sum = 0;
+    [[unroll]] for (uint l = 0; l < 4; ++l) {
+        const uint qs = uint(data_a_packed16[ib].qs[ib32 * 4 + l]);
+        const uint s = signs >> (8 * l);
+        const uint g0 = iq3s_grid[( qs       & 0xFF) | (((qh >> (2 * l    )) & 1) << 8)];
+        const uint g1 = iq3s_grid[((qs >> 8) & 0xFF) | (((qh >> (2 * l + 1)) & 1) << 8)];
+        q_sum += dotPacked4x8EXT(iq3_signed_grid(g0, s     ), cache_b_qs[2 * l    ]);
+        q_sum += dotPacked4x8EXT(iq3_signed_grid(g1, s >> 4), cache_b_qs[2 * l + 1]);
+    }
+
+    const uint scale = (uint(data_a_packed16[ib].scales[ib32 / 4]) >> ((ib32 & 3) * 4)) & 0xF;
+    const float d = float(data_a_packed16[ib].d) * float(1 + 2 * scale);
+
+    return FLOAT_TYPE(float(cache_b_ds.x) * d * float(q_sum));
+}
+#endif
+
+#if defined(DATA_A_IQ3_XXS)
+FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
+    const uint ib = ib_a / 8;
+    const uint ib32 = ib_a % 8;
+
+    // 4 x 7 sign bits (the 8th is the parity) and the 4-bit scale of this 32-value group
+    const uint ss = uint(data_a_packed16[ib].qs[QUANT_K / 8 + 2 * ib32]) |
+                    (uint(data_a_packed16[ib].qs[QUANT_K / 8 + 2 * ib32 + 1]) << 16);
+
+    int32_t q_sum = 0;
+    [[unroll]] for (uint l = 0; l < 4; ++l) {
+        const uint qs = uint(data_a_packed16[ib].qs[ib32 * 4 + l]);
+        uint s = bitfieldExtract(ss, 7 * int(l), 7);
+        s |= (bitCount(s) & 1) << 7;
+        const uint g0 = iq3xxs_grid[qs & 0xFF];
+        const uint g1 = iq3xxs_grid[qs >> 8];
+        q_sum += dotPacked4x8EXT(iq3_signed_grid(g0, s     ), cache_b_qs[2 * l    ]);
+        q_sum += dotPacked4x8EXT(iq3_signed_grid(g1, s >> 4), cache_b_qs[2 * l + 1]);
+    }
+
+    const float d = float(data_a_packed16[ib].d) * 0.5 * (0.5 + float(ss >> 28));
+
+    return FLOAT_TYPE(float(cache_b_ds.x) * d * float(q_sum));
+}
+#endif
+
+#if defined(DATA_A_IQ2_S)
+FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
+    const uint ib = ib_a / 8;
+    const uint ib32 = ib_a % 8;
+
+    // two high index bits per grid index (4 per 32 values), one sign byte per 8 values, a 4-bit scale per 16 values
+    const uint qh = uint(data_a[ib].qh[ib32]);
+    const uint sc = uint(data_a[ib].scales[ib32]);
+
+    int32_t q_sum[2] = { 0, 0 };
+    [[unroll]] for (uint k = 0; k < 4; ++k) {
+        const uint idx = uint(data_a[ib].qs[4 * ib32 + k]) | (((qh >> (2 * k)) & 3) << 8);
+        const uint s = uint(data_a[ib].qs[QUANT_K / 8 + 4 * ib32 + k]);
+        const uvec2 g = iq2s_grid[idx];
+        q_sum[k / 2] += dotPacked4x8EXT(iq3_signed_grid(g.x, s     ), cache_b_qs[2 * k    ]);
+        q_sum[k / 2] += dotPacked4x8EXT(iq3_signed_grid(g.y, s >> 4), cache_b_qs[2 * k + 1]);
+    }
+
+    const float d = float(data_a[ib].d);
+    const float sum = (0.5 + float(sc & 0xF)) * float(q_sum[0]) + (0.5 + float(sc >> 4)) * float(q_sum[1]);
+
+    return FLOAT_TYPE(float(cache_b_ds.x) * d * 0.25 * sum);
+}
+#endif
+
+#if defined(DATA_A_IQ2_XS)
+FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
+    const uint ib = ib_a / 8;
+    const uint ib32 = ib_a % 8;
+
+    const uint sc = uint(data_a[ib].scales[ib32]);
+
+    int32_t q_sum[2] = { 0, 0 };
+    [[unroll]] for (uint k = 0; k < 4; ++k) {
+        // 9-bit grid index, 7 sign bits (the 8th is the parity)
+        const uint q = uint(data_a[ib].qs[4 * ib32 + k]);
+        uint s = q >> 9;
+        s |= (bitCount(s) & 1) << 7;
+        const uvec2 g = iq2xs_grid[q & 511];
+        q_sum[k / 2] += dotPacked4x8EXT(iq3_signed_grid(g.x, s     ), cache_b_qs[2 * k    ]);
+        q_sum[k / 2] += dotPacked4x8EXT(iq3_signed_grid(g.y, s >> 4), cache_b_qs[2 * k + 1]);
+    }
+
+    const float d = float(data_a[ib].d);
+    const float sum = (0.5 + float(sc & 0xF)) * float(q_sum[0]) + (0.5 + float(sc >> 4)) * float(q_sum[1]);
+
+    return FLOAT_TYPE(float(cache_b_ds.x) * d * 0.25 * sum);
+}
+#endif
