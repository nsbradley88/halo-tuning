 // Test cases for evaluation: should try to cover edge cases while using small input sizes to keep the runtime low
+// Matvec at decode / speculative-verify shapes with optional cold weights: nw > 1 builds nw distinct weights and
+// inputs and sums the products, so the weights exceed the GPU's last-level cache (32 MiB MALL on Strix Halo) and
+// every run reads them from memory. Per-matvec time: perf mode us/run / nw (or GGML_VK_PERF_LOGGER per op).
+struct test_mul_mat_cold : public test_case {
+    const ggml_type type_a;
+    const int64_t m;
+    const int64_t n;
+    const int64_t k;
+    const int64_t nw;
+
+    std::string vars() override {
+        return VARS_TO_STR5(type_a, m, n, k, nw);
+    }
+
+    double max_nmse_err() override { return 5e-4; }
+
+    uint64_t op_flops(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        // cold variant: a flop count above the perf target, so the graph runs once per timing run and
+        // us/run is the time of the nw matvecs (+ nw-1 small adds); the printed FLOPS are not meaningful
+        return nw > 1 ? 1000ULL * 1000 * 1000 * 1000 : 2 * m * n * k;
+    }
+
+    test_mul_mat_cold(ggml_type type_a = GGML_TYPE_Q4_K, int64_t m = 4096, int64_t n = 1, int64_t k = 4096, int64_t nw = 1)
+        : type_a(type_a), m(m), n(n), k(k), nw(nw) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * out = nullptr;
+        for (int64_t i = 0; i < nw; ++i) {
+            ggml_tensor * a = ggml_new_tensor_2d(ctx, type_a, k, m);
+            ggml_set_name(a, "a");
+            ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+            ggml_set_name(b, "b");
+            ggml_tensor * mm = ggml_mul_mat(ctx, a, b);
+            out = out ? ggml_add(ctx, out, mm) : mm;
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return ggml_op_name(GGML_OP_MUL_MAT);
+    }
+};
+
+// Qwen3.8-27B (qwen35 dense) weight shapes, n = 1 (decode) .. 8 (MTP verify of up to 7 drafts)
+static void add_q27_verify_mul_mat_cases(std::vector<std::unique_ptr<test_case>> & test_cases, bool perf) {
+    struct shape { ggml_type t; int64_t m, k; };
+    const std::vector<shape> shapes = {
+        { GGML_TYPE_Q5_K,   17408,  5120 }, // ffn_up / ffn_gate
+        { GGML_TYPE_IQ4_XS, 17408,  5120 },
+        { GGML_TYPE_Q4_K,   17408,  5120 },
+        { GGML_TYPE_Q5_K,    5120, 17408 }, // ffn_down
+        { GGML_TYPE_IQ4_XS,  5120, 17408 },
+        { GGML_TYPE_Q6_K,    5120, 17408 },
+        { GGML_TYPE_Q5_K,    5120,  6144 }, // ssm_out / attn_output
+        { GGML_TYPE_Q6_K,    5120,  6144 },
+        { GGML_TYPE_Q8_0,    5120,  6144 },
+        { GGML_TYPE_Q5_K,    6144,  5120 }, // attn_gate (GDN z)
+        { GGML_TYPE_Q5_K,   10240,  5120 }, // attn_qkv (GDN)
+        { GGML_TYPE_Q4_K,   10240,  5120 },
+        { GGML_TYPE_Q8_0,      48,  5120 }, // ssm_alpha / ssm_beta
+        { GGML_TYPE_Q6_K,  248320,  5120 }, // output head
+        { GGML_TYPE_Q3_K,  248320,  5120 }, // MTP draft head
+        { GGML_TYPE_Q3_K,   32768,  5120 }, // MTP draft-vocabulary head
+    };
+    for (const auto & s : shapes) {
+        const int64_t bytes = (int64_t) ggml_row_size(s.t, s.k) * s.m;
+        if (!perf) {
+            if (s.m * s.k > 17408 * 5120) {
+                continue;
+            }
+            for (int64_t n : {1, 2, 3, 5, 8}) {
+                test_cases.emplace_back(new test_mul_mat_cold(s.t, s.m, n, s.k, 1));
+            }
+            continue;
+        }
+        const int64_t nw = std::min<int64_t>(16, std::max<int64_t>(1, (160ll*1024*1024 + bytes - 1) / bytes));
+        for (int64_t n = 1; n <= 8; ++n) {
+            test_cases.emplace_back(new test_mul_mat_cold(s.t, s.m, n, s.k, nw));
+        }
+    }
+}
+
 static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     std::vector<std::unique_ptr<test_case>> test_cases;
+
+    add_q27_verify_mul_mat_cases(test_cases, false);
     std::default_random_engine rng(0);
 
     // unary ops
@@ -12017,6 +12104,8 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
 static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
     std::vector<std::unique_ptr<test_case>> test_cases;
 
+    add_q27_verify_mul_mat_cases(test_cases, true);
+
     // SWIGLU at a 27B-class FFN width, fused [gate|up] vs split operands
     // note: same bytes either way, so a backend that indexes them differently shows it here
     for (ggml_type type : {GGML_TYPE_F16, GGML_TYPE_F32, GGML_TYPE_BF16}) {
