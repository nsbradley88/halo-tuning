From 4f3e157db5f91dd20e5c339e6226060038be8a28 Mon Sep 17 00:00:00 2001
From: nsbradley88 <3960699+nsbradley88@users.noreply.github.com>
Date: Wed, 14 Oct 2026 22:41:16 +0000
Subject: [PATCH 06/15] speculative: one-row draft-vocab scatter with dup +
 set_rows

The get_rows scatter over the full vocabulary used rows of one element (one 512-thread workgroup per
vocab entry on Vulkan, ~0.2 ms per draft step at 248K). For the one-row draft steps, copy the -inf mask
and write the subset logits to their token ids with set_rows instead. Qwen3.8-27B with a 64K subset:
draft step 2.65 -> 2.16 ms (Strix Halo, Vulkan); identical drafts and output.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/llama-context.cpp |  7 ++++++-
 src/llama-cparams.h   |  1 +
 src/llama-graph.cpp   | 12 ++++++++++--
 3 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index b5ba840a3..0aa881011 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1365,6 +1365,7 @@ bool llama_context::set_draft_vocab(const llama_token * ids, int32_t n_ids) {
     cparams.dvocab_head = nullptr;
     cparams.dvocab_inv  = nullptr;
     cparams.dvocab_mask = nullptr;
+    cparams.dvocab_ids  = nullptr;
     dvocab_buf.reset();
     dvocab_ctx.reset();
     sched_need_reserve = true;
@@ -1398,7 +1399,7 @@ bool llama_context::set_draft_vocab(const llama_token * ids, int32_t n_ids) {
     const int64_t n_sub = (int64_t) sub.size();
 
     ggml_init_params ip = {
-        /*.mem_size   =*/ 3 * ggml_tensor_overhead(),
+        /*.mem_size   =*/ 4 * ggml_tensor_overhead(),
         /*.mem_buffer =*/ nullptr,
         /*.no_alloc   =*/ true,
     };
@@ -1408,7 +1409,9 @@ bool llama_context::set_draft_vocab(const llama_token * ids, int32_t n_ids) {
     ggml_tensor * t_mask = ggml_new_tensor_1d(dvocab_ctx.get(), GGML_TYPE_F32, n_vocab);
     ggml_set_name(t_head, "dvocab_head");
     ggml_set_name(t_inv,  "dvocab_inv");
+    ggml_tensor * t_ids  = ggml_new_tensor_1d(dvocab_ctx.get(), GGML_TYPE_I32, n_sub);
     ggml_set_name(t_mask, "dvocab_mask");
+    ggml_set_name(t_ids,  "dvocab_ids");
 
     ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(head->buffer);
     dvocab_buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(dvocab_ctx.get(), buft));
@@ -1448,10 +1451,12 @@ bool llama_context::set_draft_vocab(const llama_token * ids, int32_t n_ids) {
     }
     ggml_backend_tensor_set(t_inv,  inv.data(),  0, inv.size()  * sizeof(int32_t));
     ggml_backend_tensor_set(t_mask, mask.data(), 0, mask.size() * sizeof(float));
+    ggml_backend_tensor_set(t_ids,  sub.data(),  0, sub.size()  * sizeof(int32_t));
 
     cparams.dvocab_head = t_head;
     cparams.dvocab_inv  = t_inv;
     cparams.dvocab_mask = t_mask;
+    cparams.dvocab_ids  = t_ids;
 
     LLAMA_LOG_INFO("%s: draft head over %" PRId64 " of %" PRId64 " tokens (%.1f MiB, %s)\n", __func__, n_sub, n_vocab,
             dst_rows.size() / 1048576.0, ggml_backend_buffer_name(dvocab_buf.get()));
diff --git a/src/llama-cparams.h b/src/llama-cparams.h
index 03487a9e5..22dc4b637 100644
--- a/src/llama-cparams.h
+++ b/src/llama-cparams.h
@@ -73,4 +73,5 @@ struct llama_cparams {
     ggml_tensor * dvocab_head = nullptr;
     ggml_tensor * dvocab_inv  = nullptr;
     ggml_tensor * dvocab_mask = nullptr;
+    ggml_tensor * dvocab_ids  = nullptr; // the subset token ids [n_sub] (I32), for the one-row set_rows scatter
 };
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index c9f89ef15..605746253 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1632,9 +1632,17 @@ ggml_tensor * llm_graph_context::build_mtp_head(
     }
     cb(sub, "result_output_dvocab", -1);
 
-    sub = n_rows == 1 ? ggml_reshape_2d(ctx0, sub, 1, n_sub) : ggml_cont(ctx0, ggml_transpose(ctx0, sub));
+    if (n_rows == 1) {
+        // one row (draft steps): copy the -inf mask and write the subset logits to their token ids
+        cur = ggml_reshape_2d(ctx0, ggml_dup(ctx0, cparams.dvocab_mask), 1, n_vocab);
+        cur = ggml_set_rows(ctx0, cur, ggml_reshape_2d(ctx0, sub, 1, n_sub), cparams.dvocab_ids);
+        return ggml_reshape_2d(ctx0, cur, n_vocab, 1);
+    }
+
+    // several rows: gather each vocab entry from its subset position, -inf outside the subset
+    sub = ggml_cont(ctx0, ggml_transpose(ctx0, sub));    // [n_rows, n_sub]
     cur = ggml_get_rows(ctx0, sub, cparams.dvocab_inv); // [n_rows, n_vocab]
-    cur = n_rows == 1 ? ggml_reshape_2d(ctx0, cur, n_vocab, 1) : ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+    cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
     return ggml_add(ctx0, cur, cparams.dvocab_mask);
 }
 
-- 
