+// the perf logger has no device: mirror the default / GGML_VK_MMV_MAX_COLS of the device for the _VEC label
+// (approximate: assumes the RDNA3/4 per-type rule of ggml_vk_mmv_max_cols)
+static uint32_t vk_perf_mmv_max_cols(const ggml_tensor * node) {
+    static const uint32_t v = getenv("GGML_VK_MMV_MAX_COLS") ? std::min<uint32_t>(mul_mat_vec_max_cols, (uint32_t) std::stoul(getenv("GGML_VK_MMV_MAX_COLS"))) : 0;
+    if (v != 0) {
+        return v;
+    }
+    const ggml_type t = node->src[0]->type;
+    return !ggml_is_quantized(t) ? 8 : (ggml_vk_type_has_mmvq(t) && t != GGML_TYPE_Q6_K) ? 16 : 9;
+}
