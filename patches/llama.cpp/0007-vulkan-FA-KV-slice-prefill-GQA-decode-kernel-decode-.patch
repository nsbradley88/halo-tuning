--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_decode_gqa.comp
@@ -0,0 +1,333 @@
+#version 450
+
+// Long-KV GQA decode attention for head size 128 with q8_0 / q4_0 K and V (Strix Halo experiment,
+// GGML_VK_FA_DECODE_GQA=1). One workgroup handles one KV head, one query token and one split of the KV
+// range, for all GQA query heads of that KV head at once, so every K/V row is read from memory exactly once.
+//
+// Memory: each tile of TILE tokens is fetched with coalesced 32-bit loads of whole head rows (a head row is
+// 4 blocks = 136 B for q8_0 / 72 B for q4_0, 4-byte aligned) into registers one tile ahead, then stored to
+// shared memory, so the loads of tile j+1 are in flight while tile j is computed.
+//   scores : 4 lanes per token (one 32-element block each), int8 dot products against Q quantized to int8
+//            per 32-element block (the same scheme as the scalar MMQ flash attention path)
+//   softmax: online, per head (shared running max / sum)
+//   P*V    : 32 lanes per token row (4 dims each), WG/32 token groups, f32 accumulators
+//
+// Output always uses the split-k layout and flash_attn_split_k_reduce.comp:
+//   O [HSV, ne1, k, ne2, ne3] unnormalized, then L/M [ne1, k, ne2, ne3].
+
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_EXT_integer_dot_product : require
+#extension GL_KHR_shader_subgroup_basic : enable
+#extension GL_KHR_shader_subgroup_arithmetic : enable
+#extension GL_KHR_shader_subgroup_clustered : enable
+
+#define D       128
+#define NBLK    4                         // 32-element blocks per head row
+#define WG      256
+#define TILE    64                        // tokens per tile (WG / NBLK)
+#define NGRP    (WG / 32)                 // P*V token groups
+
+layout (constant_id = 0) const uint GQA     = 6;   // query heads per KV head
+layout (constant_id = 1) const uint K_IS_Q4 = 0;
+layout (constant_id = 2) const uint V_IS_Q4 = 0;
+
+const uint K_BLK   = K_IS_Q4 != 0 ? 18 : 34;            // bytes per block
+const uint V_BLK   = V_IS_Q4 != 0 ? 18 : 34;
+const uint K_WORDS = NBLK * K_BLK / 4;                    // 32-bit words per head row (34 or 18)
+const uint V_WORDS = NBLK * V_BLK / 4;
+const uint K_LD    = (TILE * K_WORDS + WG - 1) / WG;      // loads per thread per tile
+const uint V_LD    = (TILE * V_WORDS + WG - 1) / WG;
+
+layout(local_size_x = WG, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer Q  {float data_q[];};
+layout (binding = 1) readonly buffer KW {uint data_k[];};
+layout (binding = 2) readonly buffer VW {uint data_v[];};
+layout (binding = 3) readonly buffer M  {float16_t data_m[];};
+layout (binding = 4) writeonly buffer O {float data_o[];};
+
+layout (push_constant) uniform parameter {
+    uint KV;
+    uint N;          // query tokens
+    uint ne1;        // total query heads (dst ne1)
+    uint k_num;      // splits
+    uint split_kv;   // tokens per split
+    uint q_tok;      // Q strides in floats
+    uint q_head;
+    uint k_tok;      // K strides in 32-bit words
+    uint k_head;
+    uint v_tok;      // V strides in 32-bit words
+    uint v_head;
+    uint m_row;      // mask row stride in elements
+    uint has_mask;
+    float scale;
+} p;
+
+shared float qf[GQA * D];
+shared int   qq[GQA * NBLK * 8];
+shared float qd[GQA * NBLK];
+shared int   qsum[GQA * NBLK];
+
+shared uint  ksh[TILE * K_WORDS];
+shared uint  vsh[TILE * V_WORDS];
+shared float sS[GQA * TILE];
+shared float sred[GQA * 8];
+shared float sM[GQA];
+shared float sL[GQA];
+shared float sAlpha[GQA];
+
+// 4 bytes starting at a 2-byte aligned byte offset of a shared row
+uint ld4k(uint row, uint byte_off) {
+    const uint w = row * K_WORDS + byte_off / 4;
+    return (byte_off % 4) == 0 ? ksh[w] : ((ksh[w] >> 16) | (ksh[w + 1] << 16));
+}
+uint ld4v(uint row, uint byte_off) {
+    const uint w = row * V_WORDS + byte_off / 4;
+    return (byte_off % 4) == 0 ? vsh[w] : ((vsh[w] >> 16) | (vsh[w + 1] << 16));
+}
+float ldscale_k(uint row, uint byte_off) {
+    const uint w = ksh[row * K_WORDS + byte_off / 4];
+    return unpackHalf2x16((byte_off % 4) == 0 ? w : (w >> 16)).x;
+}
+float ldscale_v(uint row, uint byte_off) {
+    const uint w = vsh[row * V_WORDS + byte_off / 4];
+    return unpackHalf2x16((byte_off % 4) == 0 ? w : (w >> 16)).x;
+}
+
+void main() {
+    const uint tid   = gl_LocalInvocationIndex;
+    const uint split = gl_WorkGroupID.x;
+    const uint g     = gl_WorkGroupID.y;     // KV head
+    const uint t     = gl_WorkGroupID.z;     // query token
+    const uint h0    = g * GQA;              // first query head of this group
+    const uint sg    = gl_SubgroupID;
+    const bool sg_lead = subgroupElect();
+
+    // ---- Q for the GQA heads, quantized to int8 per 32-element block
+    for (uint i = tid; i < GQA * D; i += WG) {
+        qf[i] = data_q[t * p.q_tok + (h0 + i / D) * p.q_head + i % D];
+    }
+    if (tid < GQA) {
+        sM[tid] = -1e30;
+        sL[tid] = 0.0;
+    }
+    barrier();
+    if (tid < GQA * NBLK) {
+        const uint h = tid / NBLK, b = tid % NBLK;
+        float amax = 0.0;
+        [[unroll]] for (uint e = 0; e < 32; ++e) {
+            amax = max(amax, abs(qf[h * D + b * 32 + e]));
+        }
+        const float dq = amax / 127.0;
+        const float id = dq != 0.0 ? 1.0 / dq : 0.0;
+        int s = 0;
+        [[unroll]] for (uint w = 0; w < 8; ++w) {
+            int packed = 0;
+            [[unroll]] for (uint c = 0; c < 4; ++c) {
+                const int v = int(round(qf[h * D + b * 32 + w * 4 + c] * id));
+                packed |= (v & 0xFF) << (8 * c);
+                s += v;
+            }
+            qq[(h * NBLK + b) * 8 + w] = packed;
+        }
+        qd[h * NBLK + b] = dq;
+        qsum[h * NBLK + b] = s;
+    }
+    barrier();
+
+    const uint b_lane = tid % NBLK;          // score phase: block of this lane
+    const uint tok_s  = tid / NBLK;          // score phase: token of this lane within the tile
+    int   qreg[GQA][8];
+    float qdreg[GQA];
+    int   qsreg[GQA];
+    [[unroll]] for (uint h = 0; h < GQA; ++h) {
+        [[unroll]] for (uint w = 0; w < 8; ++w) {
+            qreg[h][w] = qq[(h * NBLK + b_lane) * 8 + w];
+        }
+        qdreg[h] = qd[h * NBLK + b_lane];
+        qsreg[h] = qsum[h * NBLK + b_lane];
+    }
+
+    const uint pv_lane = tid % 32;           // P*V: 4 dims of the row
+    const uint pv_grp  = tid / 32;           // P*V: token group
+    const uint pv_blk  = pv_lane / 8;
+    const uint pv_e    = (pv_lane % 8) * 4;
+    vec4 acc[GQA];
+    [[unroll]] for (uint h = 0; h < GQA; ++h) {
+        acc[h] = vec4(0.0);
+    }
+    const uint n_sg_tile = (TILE + gl_SubgroupSize - 1) / gl_SubgroupSize;
+
+    const uint kv_start = split * p.split_kv;
+    const uint kv_end   = min(p.KV, kv_start + p.split_kv);
+
+    // prefetch registers: whole head rows of one tile, coalesced
+    uint kpre[K_LD], vpre[V_LD];
+    [[unroll]] for (uint i = 0; i < K_LD; ++i) {
+        const uint idx = tid + i * WG, r = idx / K_WORDS, w = idx % K_WORDS, j = kv_start + r;
+        kpre[i] = (idx < TILE * K_WORDS && j < kv_end) ? data_k[j * p.k_tok + g * p.k_head + w] : 0u;
+    }
+    [[unroll]] for (uint i = 0; i < V_LD; ++i) {
+        const uint idx = tid + i * WG, r = idx / V_WORDS, w = idx % V_WORDS, j = kv_start + r;
+        vpre[i] = (idx < TILE * V_WORDS && j < kv_end) ? data_v[j * p.v_tok + g * p.v_head + w] : 0u;
+    }
+
+    for (uint j0 = kv_start; j0 < kv_end; j0 += TILE) {
+        // ---- publish the prefetched tile, start loading the next one
+        [[unroll]] for (uint i = 0; i < K_LD; ++i) {
+            const uint idx = tid + i * WG;
+            if (idx < TILE * K_WORDS) { ksh[idx] = kpre[i]; }
+        }
+        [[unroll]] for (uint i = 0; i < V_LD; ++i) {
+            const uint idx = tid + i * WG;
+            if (idx < TILE * V_WORDS) { vsh[idx] = vpre[i]; }
+        }
+        barrier();
+        const uint jn = j0 + TILE;
+        [[unroll]] for (uint i = 0; i < K_LD; ++i) {
+            const uint idx = tid + i * WG, r = idx / K_WORDS, w = idx % K_WORDS, j = jn + r;
+            kpre[i] = (idx < TILE * K_WORDS && j < kv_end) ? data_k[j * p.k_tok + g * p.k_head + w] : 0u;
+        }
+        [[unroll]] for (uint i = 0; i < V_LD; ++i) {
+            const uint idx = tid + i * WG, r = idx / V_WORDS, w = idx % V_WORDS, j = jn + r;
+            vpre[i] = (idx < TILE * V_WORDS && j < kv_end) ? data_v[j * p.v_tok + g * p.v_head + w] : 0u;
+        }
+
+        // ---- scores
+        {
+            const uint j = j0 + tok_s;
+            float part[GQA];
+            const uint bo = b_lane * K_BLK;          // block byte offset inside the row
+            const float kd = ldscale_k(tok_s, bo);
+            if (K_IS_Q4 == 0) {
+                int kp[8];
+                [[unroll]] for (uint w = 0; w < 8; ++w) {
+                    kp[w] = int(ld4k(tok_s, bo + 2 + 4 * w));
+                }
+                [[unroll]] for (uint h = 0; h < GQA; ++h) {
+                    int s = 0;
+                    [[unroll]] for (uint w = 0; w < 8; ++w) {
+                        s = dotPacked4x8AccSatEXT(qreg[h][w], kp[w], s);
+                    }
+                    part[h] = float(s) * qdreg[h] * kd;
+                }
+            } else {
+                int lo[4], hi[4];
+                [[unroll]] for (uint w = 0; w < 4; ++w) {
+                    const uint u = ld4k(tok_s, bo + 2 + 4 * w);
+                    lo[w] = int(u & 0x0F0F0F0Fu);
+                    hi[w] = int((u >> 4) & 0x0F0F0F0Fu);
+                }
+                [[unroll]] for (uint h = 0; h < GQA; ++h) {
+                    int s = 0;
+                    [[unroll]] for (uint w = 0; w < 4; ++w) {
+                        s = dotPacked4x8AccSatEXT(qreg[h][w],     lo[w], s);
+                        s = dotPacked4x8AccSatEXT(qreg[h][w + 4], hi[w], s);
+                    }
+                    s -= 8 * qsreg[h];
+                    part[h] = float(s) * qdreg[h] * kd;
+                }
+            }
+            [[unroll]] for (uint h = 0; h < GQA; ++h) {
+                part[h] = subgroupClusteredAdd(part[h], NBLK);
+            }
+            if (b_lane == 0) {
+                float mv = 0.0;
+                if (j >= kv_end) {
+                    mv = -1.0/0.0;
+                } else if (p.has_mask != 0) {
+                    mv = float(data_m[t * p.m_row + j]);
+                }
+                [[unroll]] for (uint h = 0; h < GQA; ++h) {
+                    sS[h * TILE + tok_s] = part[h] * p.scale + mv;
+                }
+            }
+        }
+        barrier();
+
+        // ---- online softmax per head
+        if (tid < TILE) {
+            [[unroll]] for (uint h = 0; h < GQA; ++h) {
+                const float mx = subgroupMax(sS[h * TILE + tid]);
+                if (sg_lead) { sred[h * 8 + sg] = mx; }
+            }
+        }
+        barrier();
+        if (tid < GQA) {
+            float mx = sM[tid];
+            for (uint s = 0; s < n_sg_tile; ++s) { mx = max(mx, sred[tid * 8 + s]); }
+            sAlpha[tid] = exp(sM[tid] - mx);
+            sM[tid] = mx;
+        }
+        barrier();
+        if (tid < TILE) {
+            [[unroll]] for (uint h = 0; h < GQA; ++h) {
+                const float pv = exp(sS[h * TILE + tid] - sM[h]);
+                sS[h * TILE + tid] = pv;
+                const float ps = subgroupAdd(pv);
+                if (sg_lead) { sred[h * 8 + sg] = ps; }
+            }
+        }
+        barrier();
+        if (tid < GQA) {
+            float ls = 0.0;
+            for (uint s = 0; s < n_sg_tile; ++s) { ls += sred[tid * 8 + s]; }
+            sL[tid] = sL[tid] * sAlpha[tid] + ls;
+        }
+        [[unroll]] for (uint h = 0; h < GQA; ++h) {
+            acc[h] *= sAlpha[h];
+        }
+
+        // ---- P*V from shared
+        [[unroll]] for (uint k = 0; k < TILE / NGRP; ++k) {
+            const uint tl = pv_grp + k * NGRP;
+            const uint bo = pv_blk * V_BLK;
+            const float vd = ldscale_v(tl, bo);
+            vec4 vv;
+            if (V_IS_Q4 == 0) {
+                const uint u = ld4v(tl, bo + 2 + pv_e);
+                vv = vd * vec4(float(bitfieldExtract(int(u), 0, 8)),  float(bitfieldExtract(int(u), 8, 8)),
+                               float(bitfieldExtract(int(u), 16, 8)), float(bitfieldExtract(int(u), 24, 8)));
+            } else {
+                const uint u  = ld4v(tl, bo + 2 + (pv_e % 16));
+                const uint sh = pv_e < 16 ? 0 : 4;
+                vv = vd * (vec4(float((u >> sh) & 0xF), float((u >> (8 + sh)) & 0xF),
+                                float((u >> (16 + sh)) & 0xF), float((u >> (24 + sh)) & 0xF)) - 8.0);
+            }
+            [[unroll]] for (uint h = 0; h < GQA; ++h) {
+                acc[h] += sS[h * TILE + tl] * vv;
+            }
+        }
+        barrier();
+    }
+
+    // ---- combine the token groups and write O, L, M in the split-k layout
+    const uint o_base  = D * p.ne1 * (split + p.k_num * t);
+    const uint lm_base = D * p.ne1 * p.k_num * p.N + p.ne1 * 2 * (split + p.k_num * t);
+    [[unroll]] for (uint h = 0; h < GQA; ++h) {
+        // reduce over the NGRP token groups, one head at a time, using qf (free after the Q setup) as scratch
+        barrier();
+        if (pv_grp == 0) {
+            qf[pv_lane * 4 + 0] = acc[h].x; qf[pv_lane * 4 + 1] = acc[h].y;
+            qf[pv_lane * 4 + 2] = acc[h].z; qf[pv_lane * 4 + 3] = acc[h].w;
+        }
+        barrier();
+        for (uint gi = 1; gi < NGRP; ++gi) {
+            if (pv_grp == gi) {
+                qf[pv_lane * 4 + 0] += acc[h].x; qf[pv_lane * 4 + 1] += acc[h].y;
+                qf[pv_lane * 4 + 2] += acc[h].z; qf[pv_lane * 4 + 3] += acc[h].w;
+            }
+            barrier();
+        }
+        if (tid < D) {
+            data_o[o_base + D * (h0 + h) + tid] = qf[tid];
+        }
+        barrier();
+    }
+    if (tid < GQA) {
+        data_o[lm_base + h0 + tid]         = sL[tid];
+        data_o[lm_base + p.ne1 + h0 + tid] = sM[tid];
+    }
+}
