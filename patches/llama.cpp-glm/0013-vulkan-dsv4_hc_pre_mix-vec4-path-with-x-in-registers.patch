@@ -9974,6 +9974,9 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
         }
     }
     test_cases.emplace_back(new test_dsv4_hc_pre_mix(64, 3, 1, true));
+    test_cases.emplace_back(new test_dsv4_hc_pre_mix(62, 3, 20, true));   // scalar path
+    test_cases.emplace_back(new test_dsv4_hc_pre_mix(62, 33, 20, false));
+    test_cases.emplace_back(new test_dsv4_hc_pre_mix(12288, 3, 20, true)); // scalar path (> vec4 register limit)
     test_cases.emplace_back(new test_dsv4_hc_pre_mix(4096, 3, 1, false));
     test_cases.emplace_back(new test_dsv4_hc_pre_mix(4096, 1, 20, true, 37.0f));
     test_cases.emplace_back(new test_dsv4_hc_pre_mix(4096, 3, 20, true, 0.01f));
