+        : ne(ne), s_in(s_in), s_out(s_out) {}
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "SCALE_SIGMOID_SCALE";
+    }
+
+    bool run_whole_graph() override { return true; }
