+static bool ggml_vk_can_fuse_scale_sigmoid_scale(const struct ggml_cgraph * cgraph, int node_idx) {
+    if (!ggml_can_fuse(cgraph, node_idx, scale_sigmoid_scale_pattern)) {
+        return false;
+    }
+    const ggml_tensor * scale_in  = cgraph->nodes[node_idx];
+    const ggml_tensor * sigmoid   = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * scale_out = cgraph->nodes[node_idx + 2];
+    return ggml_get_unary_op(sigmoid) == GGML_UNARY_OP_SIGMOID &&
+           scale_in->src[0]->type == GGML_TYPE_F32 && scale_in->type == GGML_TYPE_F32 &&
+           sigmoid->type == GGML_TYPE_F32 && scale_out->type == GGML_TYPE_F32 &&
+           ggml_get_op_params_f32(scale_in, 1) == 0.0f && ggml_get_op_params_f32(scale_out, 1) == 0.0f &&
+           ggml_are_same_shape(scale_in->src[0], scale_out) &&
+           ggml_is_contiguous(scale_in->src[0]) && ggml_is_contiguous(scale_out);
+}
+
+static bool ggml_vk_can_fuse_rms_norm_scale(const struct ggml_cgraph * cgraph, int node_idx) {
+    if (!ggml_can_fuse(cgraph, node_idx, { GGML_OP_RMS_NORM, GGML_OP_SCALE })) {
+        return false;
+    }
+    const ggml_tensor * rms   = cgraph->nodes[node_idx];
+    const ggml_tensor * scale = cgraph->nodes[node_idx + 1];
+    return rms->src[0]->type == GGML_TYPE_F32 && rms->type == GGML_TYPE_F32 && scale->type == GGML_TYPE_F32 &&
+           ggml_are_same_shape(rms, scale) && ggml_is_contiguous(rms) && ggml_is_contiguous(scale) &&
+           ggml_get_op_params_f32(scale, 0) != 0.0f && ggml_get_op_params_f32(scale, 1) == 0.0f;
+}
