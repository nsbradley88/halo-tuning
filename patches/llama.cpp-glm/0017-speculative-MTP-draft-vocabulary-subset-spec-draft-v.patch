--- a/src/llama-ext.h
+++ b/src/llama-ext.h
@@ -100,6 +100,12 @@ LLAMA_API void llama_set_embeddings_nextn(struct llama_context * ctx, bool value
 // chain multiple trained NextN heads. Default 0 (first head).
 LLAMA_API void llama_set_nextn_layer_offset(struct llama_context * ctx, int32_t offset);
 
+// Restrict the output head of an MTP draft context to a token subset (FR-Spec style draft vocabulary): the head
+// reads only the rows of `ids` and every other logit is -inf, so a draft never proposes a token outside the
+// subset. The target model's verification is unchanged. n_ids == 0 restores the full head.
+// Returns false (and keeps the full head) if the model's MTP graph does not support it or the ids are invalid.
+LLAMA_API bool llama_set_draft_vocab(struct llama_context * ctx, const llama_token * ids, int32_t n_ids);
+
 // Marks the entries that a decision head (clef, vllm-decision2) reads, the default is 0
 // See https://github.com/ggml-org/llama.cpp/pull/29831 for details
 // A run of entries with the same value is one span, spans must be separated by entries with value 0
diff --git a/src/llama-graph.h b/src/llama-graph.h
index c68f14b15..afb61c9d6 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -893,6 +893,10 @@ struct llm_graph_params {
             return false;
         }
 
+        if (cparams.dvocab_head != other.cparams.dvocab_head) {
+            return false;
+        }
+
         return
             cparams.embeddings              == other.cparams.embeddings              &&
             cparams.embeddings_nextn        == other.cparams.embeddings_nextn        &&
diff --git a/src/models/glm5-next.cpp b/src/models/glm5-next.cpp
index 61a072204..5002eb182 100644
--- a/src/models/glm5-next.cpp
+++ b/src/models/glm5-next.cpp
@@ -746,7 +746,22 @@ llama_model_glm5_next::graph_mtp::graph_mtp(const llama_model & model, const llm
     ggml_tensor * head_w = layer.nextn.shared_head_head ? layer.nextn.shared_head_head : model.output;
     ggml_tensor * head_s = layer.nextn.shared_head_head ? layer.nextn.shared_head_head_s : model.output_s;
     GGML_ASSERT(head_w && "GLM5-Next MTP: missing both nextn.shared_head_head and output");
-    cur = build_lora_mm(head_w, cur, head_s);
+    if (cparams.dvocab_head) {
+        // draft-vocabulary subset (llama_set_draft_vocab): the head reads only the subset rows, then the logits are
+        // scattered back to the full vocabulary with -inf outside the subset
+        const int64_t n_sub   = cparams.dvocab_head->ne[1];
+        const int64_t n_vocab = cparams.dvocab_inv->ne[0];
+        const int64_t n_rows  = cur->ne[1];
+
+        ggml_tensor * sub = ggml_mul_mat(ctx0, cparams.dvocab_head, cur); // [n_sub, n_rows]
+        cb(sub, "result_output_dvocab", -1);
+        sub = n_rows == 1 ? ggml_reshape_2d(ctx0, sub, 1, n_sub) : ggml_cont(ctx0, ggml_transpose(ctx0, sub));
+        cur = ggml_get_rows(ctx0, sub, cparams.dvocab_inv);                // [n_rows, n_vocab]
+        cur = n_rows == 1 ? ggml_reshape_2d(ctx0, cur, n_vocab, 1) : ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+        cur = ggml_add(ctx0, cur, cparams.dvocab_mask);
+    } else {
+        cur = build_lora_mm(head_w, cur, head_s);
+    }
     cb(cur, "result_output", -1);
 
     res->t_logits = cur;
