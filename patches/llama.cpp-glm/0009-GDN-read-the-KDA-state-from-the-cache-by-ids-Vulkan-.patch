+// GGML_OP_GATED_DELTA_NET with the initial states read through ids from a recurrent cache with rollback planes,
+// and the snapshot CPY back into the same cache (glm5-next layout; the backend may fuse the CPY and write in place)
+struct test_gated_delta_net_ids_cache : public test_case {
+    const int64_t head_count;
+    const int64_t head_size;
+    const int64_t n_seq_tokens;
+    const int64_t n_seqs;
+    const int64_t K;        // snapshot slots = rollback planes
+    const int64_t mem_size; // cells per plane
+    const int64_t kv_head;  // first cell written
+    const int64_t rollback; // plane the initial states are read from
+
+    std::string vars() override {
+        return VARS_TO_STR8(head_count, head_size, n_seq_tokens, n_seqs, K, mem_size, kv_head, rollback);
+    }
+
+    test_gated_delta_net_ids_cache(int64_t head_count = 4, int64_t head_size = 32, int64_t n_seq_tokens = 3,
+            int64_t n_seqs = 1, int64_t K = 3, int64_t mem_size = 2, int64_t kv_head = 1, int64_t rollback = 0)
+        : head_count(head_count), head_size(head_size), n_seq_tokens(n_seq_tokens), n_seqs(n_seqs), K(K),
+          mem_size(mem_size), kv_head(kv_head), rollback(rollback) {}
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "GATED_DELTA_NET_IDS_CACHE";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const ggml_type type = GGML_TYPE_F32;
+        const int64_t S_v = head_size;
+        const int64_t H   = head_count;
+        const int64_t D   = S_v * S_v * H;
+        const int64_t n_written = std::min<int64_t>(n_seq_tokens, K);
+
+        ggml_tensor * q    = ggml_new_tensor_4d(ctx, type, S_v, H, n_seq_tokens, n_seqs);
+        ggml_tensor * k    = ggml_new_tensor_4d(ctx, type, S_v, H, n_seq_tokens, n_seqs);
+        ggml_tensor * v    = ggml_new_tensor_4d(ctx, type, S_v, H, n_seq_tokens, n_seqs);
+        ggml_tensor * g    = ggml_new_tensor_4d(ctx, type, S_v, H, n_seq_tokens, n_seqs); // KDA gate
+        ggml_tensor * beta = ggml_new_tensor_4d(ctx, type, 1,   H, n_seq_tokens, n_seqs);
+        ggml_set_name(q, "q");
+        ggml_set_name(k, "k");
+        ggml_set_name(v, "v");
+        ggml_set_name(g, "g");
+        ggml_set_name(beta, "beta");
+
+        ggml_tensor * states = ggml_new_tensor_2d(ctx, type, D, mem_size * K);
+        ggml_set_name(states, "states");
+        ggml_tensor * ids = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_seqs);
+        ggml_set_name(ids, "ids");
+
+        q = ggml_l2_norm(ctx, q, 1e-6f);
+        k = ggml_l2_norm(ctx, k, 1e-6f);
+
+        ggml_tensor * gdn = ggml_gated_delta_net_ids(ctx, q, k, v, g, beta, states, ids, K);
+
+        const size_t tail_off = ggml_row_size(type, S_v * H * n_seq_tokens * n_seqs);
+        ggml_tensor * src = ggml_view_3d(ctx, gdn, D, n_seqs, n_written,
+                ggml_row_size(type, D), ggml_row_size(type, D * n_seqs), tail_off);
+        ggml_tensor * dst = ggml_view_3d(ctx, states, D, n_seqs, n_written,
+                states->nb[1], mem_size * states->nb[1], kv_head * states->nb[1]);
+        ggml_tensor * cpy = ggml_cpy(ctx, src, dst);
+
+        // the written cache rows first, so the gdn, the views and the cpy stay adjacent
+        ggml_tensor * rows = ggml_reshape_1d(ctx, ggml_cont(ctx, cpy), D * n_seqs * n_written);
+        ggml_tensor * attn = ggml_view_1d(ctx, gdn, S_v * H * n_seq_tokens * n_seqs, 0);
+        return ggml_concat(ctx, rows, attn, 0);
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (ggml_is_view_op(t->op)) { continue; }
+            if (strcmp(t->name, "g") == 0) {
+                init_tensor_uniform(t, -5.0f, -1e-4f);
+            } else if (strcmp(t->name, "beta") == 0) {
+                init_tensor_uniform(t, 0.0f, 1.0f);
+            } else if (strcmp(t->name, "ids") == 0) {
+                std::vector<int32_t> data(n_seqs);
+                for (int64_t s = 0; s < n_seqs; ++s) {
+                    data[s] = (int32_t) (rollback * mem_size + kv_head + s);
+                }
+                ggml_backend_tensor_set(t, data.data(), 0, n_seqs * sizeof(int32_t));
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+};
