 // Test cases for evaluation: should try to cover edge cases while using small input sizes to keep the runtime low
+
+// GLM-5.3-Flash (glm5-next) decode/verify matvec shapes.
+// b_perm: b is created as [k, batch, n] and permuted to [k, n, batch] (MLA absorb: q / FA output permuted 0,2,1,3),
+// while a stays a contiguous [k, m, batch] weight.
+struct test_mul_mat_glm : public test_case {
+    const ggml_type type_a;
+    const int64_t m;
+    const int64_t n;
+    const int64_t k;
+    const int64_t batch;
+    const bool b_perm;
+    const int64_t nw; // > 1: nw distinct weights and inputs, summed (cold-cache timing via GGML_VK_PERF_LOGGER)
+
+    std::string vars() override {
+        return VARS_TO_STR7(type_a, m, n, k, batch, b_perm, nw);
+    }
+
+    double max_nmse_err() override { return 5e-4; }
+
+    uint64_t op_flops(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        // the cold variant runs its graph once per timing run: report a flop count above the perf target
+        return nw > 1 ? 1000ULL * 1000 * 1000 * 1000 : 2 * m * n * k * batch;
+    }
+
+    test_mul_mat_glm(ggml_type type_a = GGML_TYPE_Q4_K, int64_t m = 4096, int64_t n = 1, int64_t k = 8192,
+            int64_t batch = 1, bool b_perm = false, int64_t nw = 1)
+        : type_a(type_a), m(m), n(n), k(k), batch(batch), b_perm(b_perm), nw(nw) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * out = nullptr;
+        for (int64_t i = 0; i < nw; ++i) {
+            ggml_tensor * a = ggml_new_tensor_3d(ctx, type_a, k, m, batch);
+            ggml_set_name(a, "a");
+            ggml_tensor * b;
+            if (b_perm) {
+                b = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, batch, n);
+                ggml_set_name(b, "b");
+                b = ggml_permute(ctx, b, 0, 2, 1, 3);
+                ggml_set_name(b, "b_permuted");
+            } else {
+                b = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, n, batch);
+                ggml_set_name(b, "b");
+            }
+            ggml_tensor * mm = ggml_mul_mat(ctx, a, b);
+            out = out ? ggml_add(ctx, out, mm) : mm;
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return ggml_op_name(GGML_OP_MUL_MAT);
+    }
+};
