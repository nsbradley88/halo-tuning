+// ggml_compute_forward_dsv4_hc_pre_mix
+
+static void ggml_compute_forward_dsv4_hc_pre_mix_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * x      = dst->src[0];
+    const ggml_tensor * mixes  = dst->src[1];
+    const ggml_tensor * scale  = dst->src[2];
+    const ggml_tensor * base   = dst->src[3];
+    const ggml_tensor * norm_w = dst->src[4];
+
+    constexpr int64_t hc   = 4;
+    constexpr int64_t tail = 32;
+
+    const int64_t n_embd   = x->ne[0];
+    const int64_t n_tokens = x->ne[2];
+
+    GGML_ASSERT(x->ne[1] == hc);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_nelements(dst) == (n_embd + tail)*n_tokens);
+    GGML_ASSERT(ggml_is_contiguous(norm_w));
+
+    const float   rms_eps  = ggml_get_op_params_f32(dst, 0);
+    const float   norm_eps = ggml_get_op_params_f32(dst, 1);
+    const float   hc_eps   = ggml_get_op_params_f32(dst, 2);
+    const int32_t n_iter   = ggml_get_op_params_i32(dst, 3);
+    const bool    fold_rms = ggml_get_op_params_i32(dst, 4) != 0;
+
+    GGML_TENSOR_LOCALS(size_t, nbx, x,     nb);
+    GGML_TENSOR_LOCALS(size_t, nbm, mixes, nb);
+
+    const float * w  = (const float *) norm_w->data;
+    float       * d  = (float *) dst->data;
+
+    auto sc = [&](int64_t i) { return *(const float *) ((const char *) scale->data + i*scale->nb[0]); };
+    auto bs = [&](int64_t i) { return *(const float *) ((const char *) base->data  + i*base->nb[0]); };
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t dr  = (n_tokens + nth - 1) / nth;
+    const int64_t it0 = dr * ith;
+    const int64_t it1 = MIN(it0 + dr, n_tokens);
+
+    for (int64_t it = it0; it < it1; ++it) {
+        const char * xt = (const char *) x->data + it*nbx2;
+
+        // flat rms factor over all hc*n_embd values (same as ggml_rms_norm of the flat row)
+        float r = 1.0f;
+        if (fold_rms) {
+            ggml_float sum = 0.0;
+            for (int64_t ih = 0; ih < hc; ++ih) {
+                for (int64_t i0 = 0; i0 < n_embd; ++i0) {
+                    const float v = *(const float *) (xt + i0*nbx0 + ih*nbx1);
+                    sum += (ggml_float)(v*v);
+                }
+            }
+            const float mean = sum/(hc*n_embd);
+            r = 1.0f/sqrtf(mean + rms_eps);
+        }
+
+        auto mix = [&](int64_t i) {
+            return *(const float *) ((const char *) mixes->data + i*nbm0 + it*nbm1) * r;
+        };
+
+        float * tl = d + n_embd*n_tokens + it*tail;
+
+        float pre[hc];
+        for (int64_t h = 0; h < hc; ++h) {
+            const float v = mix(h)*sc(0) + bs(h);
+            pre[h] = 1.0f/(1.0f + expf(-v)) + hc_eps;
+
+            const float u = mix(hc + h)*sc(1) + bs(hc + h);
+            tl[h] = 2.0f*(1.0f/(1.0f + expf(-u)));
+        }
+
+        // comb: identical to ggml_compute_forward_dsv4_hc_comb_f32
+        float comb[hc*hc];
+        for (int64_t isrc = 0; isrc < hc; ++isrc) {
+            float max = -INFINITY;
+            for (int64_t idst = 0; idst < hc; ++idst) {
+                const int64_t idx = idst + hc*isrc;
+                const float v = mix(2*hc + idx)*sc(2) + bs(2*hc + idx);
+                comb[idx] = v;
+                max = MAX(max, v);
+            }
+            float sum = 0.0f;
+            for (int64_t idst = 0; idst < hc; ++idst) {
+                const int64_t idx = idst + hc*isrc;
+                comb[idx] = expf(comb[idx] - max);
+                sum += comb[idx];
+            }
+            const float inv_sum = 1.0f/sum;
+            for (int64_t idst = 0; idst < hc; ++idst) {
+                const int64_t idx = idst + hc*isrc;
+                comb[idx] = comb[idx]*inv_sum + hc_eps;
+            }
+        }
+        ggml_dsv4_hc_comb_norm_cols(comb, hc_eps);
+        for (int32_t i = 1; i < n_iter; ++i) {
+            ggml_dsv4_hc_comb_norm_rows(comb, hc_eps);
+            ggml_dsv4_hc_comb_norm_cols(comb, hc_eps);
+        }
+        for (int64_t i = 0; i < hc*hc; ++i) {
+            tl[hc + i] = comb[i];
+        }
+        tl[hc + hc*hc] = r;
+        for (int64_t i = hc + hc*hc + 1; i < tail; ++i) {
+            tl[i] = 0.0f;
+        }
+
+        // collapse the streams, then rms_norm * w
+        float * y = d + it*n_embd;
+        ggml_float sum = 0.0;
+        for (int64_t i0 = 0; i0 < n_embd; ++i0) {
+            float v = 0.0f;
+            for (int64_t h = 0; h < hc; ++h) {
+                v += *(const float *) (xt + i0*nbx0 + h*nbx1) * pre[h];
+            }
+            y[i0] = v;
+            sum += (ggml_float)(v*v);
+        }
+        const float mean = sum/n_embd;
+        const float s    = 1.0f/sqrtf(mean + norm_eps);
+        for (int64_t i0 = 0; i0 < n_embd; ++i0) {
+            y[i0] = y[i0]*s*w[i0];
+        }
+    }
+}
+
+void ggml_compute_forward_dsv4_hc_pre_mix(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    switch (dst->src[0]->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_dsv4_hc_pre_mix_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("fatal error");
+            }
+    }
+}
