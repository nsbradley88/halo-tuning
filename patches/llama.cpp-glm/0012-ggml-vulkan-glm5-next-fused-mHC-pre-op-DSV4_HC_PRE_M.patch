diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_pre_mix.comp b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_pre_mix.comp
new file mode 100644
index 000000000..d55d474ef
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_pre_mix.comp
@@ -0,0 +1,175 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_shuffle : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+
+// The whole mHC "pre" half for one token per workgroup (hc = 4):
+//   r       = fold_rms ? inversesqrt(mean(x^2) + rms_eps) : 1     (flat rms of the 4 streams)
+//   pre[h]  = sigmoid((mixes[h]*r)*scale[0] + base[h]) + hc_eps
+//   post[h] = 2*sigmoid((mixes[4+h]*r)*scale[1] + base[4+h])
+//   comb    = sinkhorn(softmax((mixes[8..23]*r)*scale[2] + base[8..23]))   (as dsv4_hc_comb.comp)
+//   y       = rms_norm(sum_h x[:, h]*pre[h], norm_eps) * norm_w
+// dst: y as [n_embd, n_tokens], then a 32-float tail per token: post[4] | comb[16] | r | 0...
+
+layout(constant_id = 0) const uint BLOCK_SIZE = 512;
+layout(constant_id = 1) const uint SUBGROUP_SIZE = 32;
+
+layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter
+{
+    uint n_embd;
+    uint n_tokens;
+
+    uint nbx0; uint nbx1; uint nbx2;   // x
+    uint nbm0; uint nbm1;              // mixes
+    uint nbs0;                         // scale
+    uint nbb0;                         // base
+
+    uint x_offset;
+    uint m_offset;
+    uint s_offset;
+    uint b_offset;
+    uint w_offset;
+    uint d_offset;
+
+    float rms_eps;
+    float norm_eps;
+    float hc_eps;
+    uint  n_iter;
+    uint  fold_rms;
+};
+
+layout(binding = 0, std430) readonly buffer X { float data_x[]; };
+layout(binding = 1, std430) readonly buffer M { float data_m[]; };
+layout(binding = 2, std430) readonly buffer S { float data_s[]; };
+layout(binding = 3, std430) readonly buffer B { float data_b[]; };
+layout(binding = 4, std430) readonly buffer W { float data_w[]; };
+layout(binding = 5, std430) buffer D { float data_d[]; };
+
+const uint hc   = 4;
+const uint TAIL = 32;
+const uint N_SUBGROUPS = BLOCK_SIZE / SUBGROUP_SIZE;
+
+shared float red[N_SUBGROUPS];
+shared float r_s;
+shared float pre_s[hc];
+
+float wg_sum(float v) {
+    v = subgroupAdd(v);
+    if (gl_SubgroupInvocationID == 0) {
+        red[gl_SubgroupID] = v;
+    }
+    barrier();
+    float s = 0.0f;
+    [[unroll]] for (uint i = 0; i < N_SUBGROUPS; ++i) {
+        s += red[i];
+    }
+    barrier();
+    return s;
+}
+
+float sigmoid(float v) {
+    return 1.0f / (1.0f + exp(-v));
+}
+
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    const uint it  = gl_WorkGroupID.x;
+
+    const uint xb = x_offset + it * nbx2;
+    const uint yb = d_offset + it * n_embd;
+    const uint tb = d_offset + n_tokens * n_embd + it * TAIL;
+
+    // pass 1: flat rms factor
+    float r = 1.0f;
+    if (fold_rms != 0) {
+        float ss = 0.0f;
+        [[unroll]] for (uint h = 0; h < hc; ++h) {
+            for (uint i = tid; i < n_embd; i += BLOCK_SIZE) {
+                const float v = data_x[xb + i * nbx0 + h * nbx1];
+                ss = fma(v, v, ss);
+            }
+        }
+        ss = wg_sum(ss);
+        r = inversesqrt(ss / float(hc * n_embd) + rms_eps);
+    }
+
+    // weights: subgroup 0 does all of it, the 4x4 sinkhorn in a 16-lane slice
+    if (gl_SubgroupID == 0) {
+        const uint lane = gl_SubgroupInvocationID;
+        const uint idx  = lane & 15;    // idst + hc*isrc
+
+        float v = (data_m[m_offset + (2*hc + idx) * nbm0 + it * nbm1] * r) * data_s[s_offset + 2 * nbs0]
+                + data_b[b_offset + (2*hc + idx) * nbb0];
+
+        float vmax = max(v, subgroupShuffleXor(v, 1));
+        vmax = max(vmax, subgroupShuffleXor(vmax, 2));
+        v = exp(v - vmax);
+
+        float sum = v + subgroupShuffleXor(v, 1);
+        sum += subgroupShuffleXor(sum, 2);
+        v = v / sum + hc_eps;
+
+        sum = v + subgroupShuffleXor(v, 4);
+        sum += subgroupShuffleXor(sum, 8);
+        v /= sum + hc_eps;
+
+        for (uint i = 1; i < n_iter; ++i) {
+            sum = v + subgroupShuffleXor(v, 1);
+            sum += subgroupShuffleXor(sum, 2);
+            v /= sum + hc_eps;
+
+            sum = v + subgroupShuffleXor(v, 4);
+            sum += subgroupShuffleXor(sum, 8);
+            v /= sum + hc_eps;
+        }
+
+        if (lane < 16) {
+            data_d[tb + hc + idx] = v;
+        }
+
+        if (lane < hc) {
+            const float u = (data_m[m_offset + lane * nbm0 + it * nbm1] * r) * data_s[s_offset] + data_b[b_offset + lane * nbb0];
+            pre_s[lane] = sigmoid(u) + hc_eps;
+        } else if (lane < 2*hc) {
+            const float u = (data_m[m_offset + lane * nbm0 + it * nbm1] * r) * data_s[s_offset + nbs0] + data_b[b_offset + lane * nbb0];
+            data_d[tb + lane - hc] = 2.0f * sigmoid(u);
+        }
+    } else if (gl_SubgroupID == 1) {
+        const uint lane = gl_SubgroupInvocationID;
+        if (lane == 0) {
+            data_d[tb + hc + hc*hc] = r;
+        } else if (hc + hc*hc + lane < TAIL) {
+            data_d[tb + hc + hc*hc + lane] = 0.0f;
+        }
+    }
+    barrier();
+
+    const float p0 = pre_s[0];
+    const float p1 = pre_s[1];
+    const float p2 = pre_s[2];
+    const float p3 = pre_s[3];
+
+    // pass 2: collapse the streams (same fma order as dsv4_hc_pre.comp)
+    float ss2 = 0.0f;
+    for (uint i = tid; i < n_embd; i += BLOCK_SIZE) {
+        const uint xi = xb + i * nbx0;
+        float y = 0.0f;
+        y = fma(data_x[xi           ], p0, y);
+        y = fma(data_x[xi +     nbx1], p1, y);
+        y = fma(data_x[xi + 2 * nbx1], p2, y);
+        y = fma(data_x[xi + 3 * nbx1], p3, y);
+        data_d[yb + i] = y;
+        ss2 = fma(y, y, ss2);
+    }
+    ss2 = wg_sum(ss2);
+    const float scale = inversesqrt(ss2 / float(n_embd) + norm_eps);
+
+    // pass 3: rms_norm * w, each invocation rereads only its own writes
+    for (uint i = tid; i < n_embd; i += BLOCK_SIZE) {
+        data_d[yb + i] = scale * data_d[yb + i] * data_w[w_offset + i];
+    }
+}
