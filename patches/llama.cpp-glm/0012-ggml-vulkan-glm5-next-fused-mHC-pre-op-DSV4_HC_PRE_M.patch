+            struct ggml_tensor  * scale,
+            struct ggml_tensor  * base,
+            struct ggml_tensor  * norm_w,
+            float                 rms_eps,
+            float                 norm_eps,
+            float                 hc_eps,
+            int32_t               n_iter,
+            bool                  fold_rms);
+
+    GGML_API struct ggml_tensor * ggml_dsv4_hc_pre_mix_y   (struct ggml_context * ctx, struct ggml_tensor * pre_mix);
+    GGML_API struct ggml_tensor * ggml_dsv4_hc_pre_mix_post(struct ggml_context * ctx, struct ggml_tensor * pre_mix);
+    GGML_API struct ggml_tensor * ggml_dsv4_hc_pre_mix_comb(struct ggml_context * ctx, struct ggml_tensor * pre_mix);
