+    // hc_pre_mix: the whole mHC "pre" half in one op (hc must be 4):
+    //   x      [n_embd, hc, n_tokens]   residual streams
+    //   mixes  [(2 + hc)*hc, n_tokens]  hc_fn * flat(x) (fold_rms) or hc_fn * rms_norm(flat(x))
+    //   scale  [3], base [(2 + hc)*hc], norm_w [n_embd]
+    // r       = fold_rms ? 1/sqrt(mean(flat(x)^2) + rms_eps) : 1
+    // pre[h]  = sigmoid((mixes[h]*r)*scale[0] + base[h]) + hc_eps
+    // post[h] = 2*sigmoid((mixes[hc + h]*r)*scale[1] + base[hc + h])
+    // comb    = ggml_dsv4_hc_comb() of mixes*r
+    // y[i]    = rms_norm(sum_h x[i, h]*pre[h], norm_eps)*norm_w[i]
+    // Result is a flat f32 tensor of (n_embd + 32)*n_tokens floats: y as a contiguous
+    // [n_embd, n_tokens] block, followed by a [32, n_tokens] tail per token holding
+    // post[hc] | comb[hc*hc] (dst-major, as hc_comb) | r | pad.
+    // Use ggml_dsv4_hc_pre_mix_{y,post,comb} for views.
