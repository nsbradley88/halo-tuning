+struct test_dsv4_hc_pre_mix : public test_dsv4_hc {
+    const int64_t n_embd;
+    const int64_t n_tokens;
+    const int32_t n_iter;
+    const bool    fold;
+    const float   x_scale;   // != 1: scale x in-graph to test large/small norms
+    const ggml_type mm_type; // GGML_TYPE_COUNT: mixes is an input, else mixes = hc_fn(mm_type) * x as in glm5-next
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "DSV4_HC_PRE_MIX";
+    }
+
+    std::string vars() override {
+        return VARS_TO_STR6(n_embd, n_tokens, n_iter, fold, x_scale, mm_type);
+    }
+
+    bool run_whole_graph() override { return mm_type != GGML_TYPE_COUNT || x_scale != 1.0f; }
+
+    double max_nmse_err() override { return mm_type == GGML_TYPE_COUNT ? 1e-6 : 5e-4; }
+
+    test_dsv4_hc_pre_mix(int64_t n_embd = 64, int64_t n_tokens = 3, int32_t n_iter = 20, bool fold = true,
+            float x_scale = 1.0f, ggml_type mm_type = GGML_TYPE_COUNT)
+        : n_embd(n_embd), n_tokens(n_tokens), n_iter(n_iter), fold(fold), x_scale(x_scale), mm_type(mm_type) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * x = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_embd, hc, n_tokens);
+        ggml_set_name(x, "x");
+        if (x_scale != 1.0f) {
+            x = ggml_scale(ctx, x, x_scale);
+        }
+
+        ggml_tensor * mixes;
+        if (mm_type == GGML_TYPE_COUNT) {
+            mixes = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, (2 + hc)*hc, n_tokens);
+            ggml_set_name(mixes, "mixes");
+        } else {
+            ggml_tensor * hc_fn = ggml_new_tensor_2d(ctx, mm_type, hc*n_embd, (2 + hc)*hc);
+            ggml_set_name(hc_fn, "hc_fn");
+            ggml_tensor * flat = ggml_reshape_2d(ctx, x, hc*n_embd, n_tokens);
+            if (!fold) {
+                flat = ggml_rms_norm(ctx, flat, 1e-6f);
+            }
+            mixes = ggml_mul_mat(ctx, hc_fn, flat);
+        }
+
+        ggml_tensor * scale = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 3);
+        ggml_set_name(scale, "scale");
+
+        ggml_tensor * base = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, (2 + hc)*hc);
+        ggml_set_name(base, "base");
+
+        ggml_tensor * norm_w = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd);
+        ggml_set_name(norm_w, "norm_w");
+
+        out = ggml_dsv4_hc_pre_mix(ctx, x, mixes, scale, base, norm_w, 1e-6f, 1e-5f, 1e-6f, n_iter, fold);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
