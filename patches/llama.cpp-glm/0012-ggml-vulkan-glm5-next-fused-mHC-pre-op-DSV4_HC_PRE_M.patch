+// ggml_dsv4_hc_pre_mix
+
+#define GGML_DSV4_HC_PRE_MIX_TAIL 32
+
+struct ggml_tensor * ggml_dsv4_hc_pre_mix(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * mixes,
+        struct ggml_tensor  * scale,
+        struct ggml_tensor  * base,
+        struct ggml_tensor  * norm_w,
+        float                 rms_eps,
+        float                 norm_eps,
+        float                 hc_eps,
+        int32_t               n_iter,
+        bool                  fold_rms) {
+    GGML_ASSERT(x->type      == GGML_TYPE_F32);
+    GGML_ASSERT(mixes->type  == GGML_TYPE_F32);
+    GGML_ASSERT(scale->type  == GGML_TYPE_F32);
+    GGML_ASSERT(base->type   == GGML_TYPE_F32);
+    GGML_ASSERT(norm_w->type == GGML_TYPE_F32);
+    GGML_ASSERT(n_iter > 0);
+
+    const int64_t n_embd   = x->ne[0];
+    const int64_t hc       = x->ne[1];
+    const int64_t n_tokens = x->ne[2];
+
+    GGML_ASSERT(hc == 4);
+    GGML_ASSERT(x->ne[3] == 1);
+    GGML_ASSERT(mixes->ne[0] == (2 + hc)*hc);
+    GGML_ASSERT(mixes->ne[1] == n_tokens);
+    GGML_ASSERT(mixes->ne[2] == 1 && mixes->ne[3] == 1);
+    GGML_ASSERT(scale->ne[0] >= 3);
+    GGML_ASSERT(ggml_nelements(base) == (2 + hc)*hc);
+    GGML_ASSERT(ggml_nelements(norm_w) == n_embd);
+    GGML_ASSERT(ggml_is_contiguous(norm_w));
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, (n_embd + GGML_DSV4_HC_PRE_MIX_TAIL)*n_tokens);
+
+    ggml_set_op_params_f32(result, 0, rms_eps);
+    ggml_set_op_params_f32(result, 1, norm_eps);
+    ggml_set_op_params_f32(result, 2, hc_eps);
+    ggml_set_op_params_i32(result, 3, n_iter);
+    ggml_set_op_params_i32(result, 4, fold_rms ? 1 : 0);
+    ggml_set_op_params_i32(result, 5, (int32_t) n_embd);
+    ggml_set_op_params_i32(result, 6, (int32_t) n_tokens);
+
+    result->op     = GGML_OP_DSV4_HC_PRE_MIX;
+    result->src[0] = x;
+    result->src[1] = mixes;
+    result->src[2] = scale;
+    result->src[3] = base;
+    result->src[4] = norm_w;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv4_hc_pre_mix_y(struct ggml_context * ctx, struct ggml_tensor * pre_mix) {
+    GGML_ASSERT(pre_mix->op == GGML_OP_DSV4_HC_PRE_MIX);
+    const int64_t n_embd   = ggml_get_op_params_i32(pre_mix, 5);
+    const int64_t n_tokens = ggml_get_op_params_i32(pre_mix, 6);
+    return ggml_view_2d(ctx, pre_mix, n_embd, n_tokens, n_embd*sizeof(float), 0);
+}
+
+struct ggml_tensor * ggml_dsv4_hc_pre_mix_post(struct ggml_context * ctx, struct ggml_tensor * pre_mix) {
+    GGML_ASSERT(pre_mix->op == GGML_OP_DSV4_HC_PRE_MIX);
+    const int64_t n_embd   = ggml_get_op_params_i32(pre_mix, 5);
+    const int64_t n_tokens = ggml_get_op_params_i32(pre_mix, 6);
+    return ggml_view_2d(ctx, pre_mix, 4, n_tokens, GGML_DSV4_HC_PRE_MIX_TAIL*sizeof(float),
+            n_embd*n_tokens*sizeof(float));
+}
+
+struct ggml_tensor * ggml_dsv4_hc_pre_mix_comb(struct ggml_context * ctx, struct ggml_tensor * pre_mix) {
+    GGML_ASSERT(pre_mix->op == GGML_OP_DSV4_HC_PRE_MIX);
+    const int64_t n_embd   = ggml_get_op_params_i32(pre_mix, 5);
+    const int64_t n_tokens = ggml_get_op_params_i32(pre_mix, 6);
+    return ggml_view_3d(ctx, pre_mix, 4, 4, n_tokens, 4*sizeof(float), GGML_DSV4_HC_PRE_MIX_TAIL*sizeof(float),
+            (n_embd*n_tokens + 4)*sizeof(float));
+}
