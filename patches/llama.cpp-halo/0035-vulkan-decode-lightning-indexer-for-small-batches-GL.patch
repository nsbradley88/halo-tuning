diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/lightning_indexer_vec.comp b/ggml/src/ggml-vulkan/vulkan-shaders/lightning_indexer_vec.comp
new file mode 100644
index 000000000..6c0e83477
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/lightning_indexer_vec.comp
@@ -0,0 +1,120 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+
+#define BINDING_IDX_K 0u
+
+#include "types.glsl"
+#include "fa_types.glsl"
+#define FaTypeV GGML_TYPE_F32
+
+layout(constant_id = 0) const uint FaTypeK = GGML_TYPE_F32;
+layout(constant_id = 1) const uint FaBlockBytesK = 4;
+
+#include "flash_attn_dequant.glsl"
+
+// Decode variant of lightning_indexer.comp for a few query tokens (speculative verify, MTP drafts).
+// Each invocation owns one key: it holds the key row in registers and scores it against every head of every
+// token, so all the parallelism is over the keys and no invocation idles. q and the head weights are the same
+// for the whole workgroup (uniform loads), and everything is accumulated in fp32.
+// The host guarantees vec4-aligned q rows and, for f16/bf16/f32 keys, vec4-aligned key rows.
+#define HEAD_SIZE 128
+#define WG_SIZE   64
+
+layout(local_size_x = WG_SIZE, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) restrict readonly buffer QBuf { vec4 q4[]; };
+layout(binding = 1) restrict readonly buffer KBufF16V4 { f16vec4 k_f16v4[]; };
+layout(binding = 2) restrict readonly buffer WBuf { float weights[]; };
+layout(binding = 3) restrict readonly buffer MBuf { float16_t mask[]; };
+layout(binding = 4) restrict writeonly buffer DstBuf { float dst[]; };
+
+layout(push_constant) uniform PushConstants {
+    uint n_kv;
+    uint n_heads;
+    uint n_tokens;
+    uint n_masks;
+    uint q_nb1;
+    uint q_nb2;
+    uint q_nb3;
+    uint k_nb2;
+    uint k_nb3;
+    uint w_nb1;
+    uint w_nb3;
+    uint m_nb1;
+    uint m_nb3;
+    uint d_nb1;
+    uint d_nb3;
+};
+
+void main() {
+    const uint s  = gl_WorkGroupID.z;
+    const uint ik = gl_WorkGroupID.x * WG_SIZE + gl_LocalInvocationID.x;
+
+    if (fa_type_needs_shmem(FaTypeK)) {
+        init_iq_shmem(gl_WorkGroupSize);
+    }
+
+    // out-of-range invocations score a duplicate of the last key and do not store,
+    // so control flow around the uniform loads below stays uniform
+    const bool valid = ik < n_kv;
+    const uint ikc = valid ? ik : n_kv - 1;
+
+    const uint k_offset = ikc * k_nb2 + s * k_nb3; // bytes
+
+    vec4 kr[HEAD_SIZE / 4];
+    [[unroll]] for (uint c4 = 0; c4 < HEAD_SIZE / 4; ++c4) {
+        if (FaTypeK == GGML_TYPE_F16) {
+            kr[c4] = vec4(k_f16v4[k_offset / 8 + c4]);
+        } else if (FaTypeK == GGML_TYPE_F32) {
+            kr[c4] = k_packed_f32.data[k_offset / 16 + c4];
+        } else if (FaTypeK == GGML_TYPE_BF16) {
+            kr[c4] = bf16_to_fp32(uvec4(k_packed_bf16.data[k_offset / 8 + c4]));
+        } else {
+            const uint k_block_elems = fa_block_elems(FaTypeK);
+            kr[c4] = vec4(dequantize4((c4 * 4) / k_block_elems, (c4 * 4) % k_block_elems, k_offset / FaBlockBytesK, BINDING_IDX_K));
+        }
+    }
+
+    // the host spreads the tokens over gl_NumWorkGroups.y workgroups (one each in practice)
+    for (uint t = gl_WorkGroupID.y; t < n_tokens; t += gl_NumWorkGroups.y) {
+        const uint q_t = t * q_nb2 + s * q_nb3;
+        const uint w_t = t * w_nb1 + s * w_nb3;
+
+        float score = 0.0;
+
+        uint h = 0;
+        // two heads per step for more independent fma chains
+        for (; h + 1 < n_heads; h += 2) {
+            const uint qa = (q_t + h * q_nb1) / 4;
+            const uint qb = qa + q_nb1 / 4;
+            vec4 a = vec4(0.0);
+            vec4 b = vec4(0.0);
+            [[unroll]] for (uint c4 = 0; c4 < HEAD_SIZE / 4; ++c4) {
+                a = fma(kr[c4], q4[qa + c4], a);
+                b = fma(kr[c4], q4[qb + c4], b);
+            }
+            const float da = (a.x + a.y) + (a.z + a.w);
+            const float db = (b.x + b.y) + (b.z + b.w);
+            score += max(da, 0.0) * weights[w_t + h];
+            score += max(db, 0.0) * weights[w_t + h + 1];
+        }
+        if (h < n_heads) {
+            const uint qa = (q_t + h * q_nb1) / 4;
+            vec4 a = vec4(0.0);
+            [[unroll]] for (uint c4 = 0; c4 < HEAD_SIZE / 4; ++c4) {
+                a = fma(kr[c4], q4[qa + c4], a);
+            }
+            const float da = (a.x + a.y) + (a.z + a.w);
+            score += max(da, 0.0) * weights[w_t + h];
+        }
+
+        if (valid) {
+            const uint mask_offset = ik + t * m_nb1 + (s % n_masks) * m_nb3;
+            dst[ik + t * d_nb1 + s * d_nb3] = score + float(mask[mask_offset]);
+        }
+    }
+}
