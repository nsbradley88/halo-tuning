+bool llama_kv_cache::sparse_active(uint32_t n_tokens, uint32_t n_kv) const {
+    return sparse.k > 0 && n_tokens <= 8 && (int32_t) n_kv >= sparse.min_ctx && (int32_t) (n_kv / sparse.bs) >= 4 * sparse.k;
+}
+
+ggml_tensor * llama_kv_cache::get_ks(ggml_context * ctx, int32_t il, uint32_t n_kv) const {
+    const int32_t ikv = map_layer_ids.at(il);
+    ggml_tensor * ks = layers[ikv].ks;
+    GGML_ASSERT(ks != nullptr);
+    return ggml_view_3d(ctx, ks, ks->ne[0], n_kv / sparse.bs, ks->ne[2], ks->nb[1], ks->nb[2], 0);
+}
+
+ggml_tensor * llama_kv_cache::build_input_sp_bias(ggml_context * ctx, const llama_ubatch & ubatch, uint32_t n_kv) const {
+    // [n_blk, n_tokens, 2]: plane 0 = softmax bias (0 / -inf for empty blocks), plane 1 = selection bias (+1e4 forced)
+    ggml_tensor * t = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_kv / sparse.bs, ubatch.n_tokens, 2);
+    ggml_set_input(t);
+    ggml_set_name(t, "attn_inp_sp_bias");
+    return t;
+}
+
+void llama_kv_cache::set_input_sp_bias(ggml_tensor * pre, ggml_tensor * post, const llama_ubatch * ubatch, const slot_info & sinfo) const {
+    GGML_ASSERT(ggml_backend_buffer_is_host(pre->buffer));
+    GGML_UNUSED(post);
+    float * d = (float *) pre->data;
+
+    const auto & cells = v_cells[sinfo.strm[0]];
+    const int64_t n_blk    = pre->ne[0];
+    const int64_t n_tokens = pre->ne[1];
+    const int64_t bs       = sparse.bs;
+
+    llama_pos pos_max = -1;
+    for (uint32_t i = 0; i < ubatch->n_tokens; ++i) {
+        pos_max = std::max(pos_max, ubatch->pos[i]);
+    }
+
+    // Exact per-cell scans only where they matter (the sink blocks and the blocks near the end of the used range);
+    // the blocks in between are treated as occupied and not forced. This keeps the host cost independent of n_kv;
+    // the dense mask still hides any empty cell inside a selected block, so this only affects which blocks are picked.
+    const int64_t used_end = cells.used_max_p1();
+    const int64_t n_sink_b = (sparse.sink + bs - 1) / bs;
+    const int64_t n_tail_b = (sparse.recent + bs - 1) / bs + 2;
+    const int64_t tail_b0  = std::max<int64_t>(0, (used_end + bs - 1) / bs - n_tail_b);
+
+    auto put = [&](int64_t b, bool empty, bool forced) {
+        for (int64_t t = 0; t < n_tokens; ++t) {
+            d[0*n_blk*n_tokens + t*n_blk + b] = empty ? -INFINITY : 0.0f;
+            d[1*n_blk*n_tokens + t*n_blk + b] = empty ? -1e30f : (forced ? 1e4f : 0.0f);
+        }
+    };
+    auto scan = [&](int64_t b) {
+        llama_pos pmin = std::numeric_limits<llama_pos>::max(), pmax = -1;
+        for (int64_t c = b*bs; c < (b + 1)*bs && c < used_end; ++c) {
+            if (!cells.is_empty(c)) {
+                const llama_pos p = cells.pos_get(c);
+                pmin = std::min(pmin, p);
+                pmax = std::max(pmax, p);
+            }
+        }
+        const bool empty = pmax < 0;
+        put(b, empty, !empty && (pmin < sparse.sink || pmax > pos_max - sparse.recent));
+    };
+
+    for (int64_t b = 0; b < n_blk; ++b) {
+        if (b*bs >= used_end) {
+            put(b, true, false);
+        } else if (b < n_sink_b || b >= tail_b0) {
+            scan(b);
+        } else {
+            put(b, false, false);
+        }
+    }
+
+}
+
+std::vector<int64_t> llama_kv_cache::sparse_host_blocks(const slot_info & sinfo) const {
+    // blocks whose bounds need a refresh after this ubatch. A small (decode) ubatch only refreshes the blocks it
+    // completes: a partly written block is always among the forced recent blocks, so its bounds are not read until
+    // it is full. Larger ubatches (prompt processing) refresh every block they touch.
+    std::vector<int64_t> blk;
+    if (sparse.k <= 0) {
+        return blk;
+    }
+    const int64_t bs = sparse.bs;
+    const bool small = sinfo.size() <= 8;
+    for (uint32_t i = 0; i < sinfo.size(); ++i) {
+        const int64_t c = sinfo.idxs[0][i];
+        if (small && c % bs != bs - 1) {
+            continue;
+        }
+        const int64_t b = c / bs;
+        if (std::find(blk.begin(), blk.end(), b) == blk.end()) {
+            blk.push_back(b);
+        }
+    }
+    return blk;
+}
+
+void llama_kv_cache::sparse_host_update(const slot_info & sinfo) const {
+    if (sparse.k <= 0) {
+        return;
+    }
+    const int64_t bs = sparse.bs;
+
+    std::vector<int64_t> blk = sparse_host_blocks(sinfo);
+    if (blk.empty()) {
+        return;
+    }
+
+    std::vector<uint8_t> raw;
+    std::vector<float>   val;
+    std::vector<float>   out;
+    for (const auto & layer : layers) {
+        ggml_tensor * k  = layer.k;
+        ggml_tensor * ks = layer.ks;
+        if (!ks) {
+            continue;
+        }
+        const int64_t n_embd = k->ne[0];             // n_embd_head_k * n_head_kv
+        const int64_t hd     = ks->ne[0] / 2;
+        const int64_t n_hkv  = ks->ne[2];
+        const size_t  rsz    = ggml_row_size(k->type, n_embd);
+        const auto  * tt     = ggml_get_type_traits(k->type);
+
+        raw.resize(bs*rsz);
+        val.resize(bs*n_embd);
+        out.resize(2*hd*n_hkv);
+        for (int64_t b : blk) {
+            ggml_backend_tensor_get(k, raw.data(), b*bs*k->nb[1], bs*rsz);
+            for (int64_t c = 0; c < bs; ++c) {
+                if (k->type == GGML_TYPE_F32) {
+                    memcpy(val.data() + c*n_embd, raw.data() + c*rsz, rsz);
+                } else {
+                    tt->to_float(raw.data() + c*rsz, val.data() + c*n_embd, n_embd);
+                }
+            }
+            for (int64_t h = 0; h < n_hkv; ++h) {
+                for (int64_t d = 0; d < hd; ++d) {
+                    float mx = -INFINITY, mn = INFINITY;
+                    for (int64_t c = 0; c < bs; ++c) {
+                        const float x = val[c*n_embd + h*hd + d];
+                        mx = std::max(mx, x);
+                        mn = std::min(mn, x);
+                    }
+                    out[h*2*hd + d]      = mx;
+                    out[h*2*hd + hd + d] = mn;
+                }
+            }
+            // ks is [2*hd, kv_size/bs, n_hkv]: one 2*hd row per head, heads strided by nb[2]
+            ggml_backend_tensor_set_2d(ks, out.data(), b*ks->nb[1], 2*hd*sizeof(float), n_hkv, ks->nb[2], 2*hd*sizeof(float));
+        }
+    }
+}
+
 ggml_tensor * llama_kv_cache::get_k(ggml_context * ctx, int32_t il, uint32_t n_kv, const slot_info & sinfo) const {
     const int32_t ikv = map_layer_ids.at(il);
 
@@ -2893,6 +3065,30 @@ uint32_t llama_kv_cache_context::get_n_kv() const {
     return n_kv;
 }
 
+bool llama_kv_cache_context::sparse_active(uint32_t n_tokens) const {
+    return kv->sparse_active(n_tokens, n_kv);
+}
+
+bool llama_kv_cache_context::sparse_host_pending() const {
+    return !kv->sparse_host_blocks(sinfos[i_cur]).empty();
+}
+
+void llama_kv_cache_context::sparse_host_update() const {
+    kv->sparse_host_update(sinfos[i_cur]);
+}
+
+ggml_tensor * llama_kv_cache_context::get_ks(ggml_context * ctx, int32_t il) const {
+    return kv->get_ks(ctx, il, n_kv);
+}
+
+ggml_tensor * llama_kv_cache_context::build_input_sp_bias(ggml_context * ctx, const llama_ubatch & ubatch) const {
+    return kv->build_input_sp_bias(ctx, ubatch, n_kv);
+}
+
+void llama_kv_cache_context::set_input_sp_bias(ggml_tensor * pre, ggml_tensor * post, const llama_ubatch * ubatch) const {
+    kv->set_input_sp_bias(pre, post, ubatch, sinfos[i_cur]);
+}
+
 ggml_type llama_kv_cache_context::type_k() const {
     return kv->type_k();
 }
diff --git a/src/llama-kv-cache.h b/src/llama-kv-cache.h
index 9bfb8f231..4fcb578fe 100644
--- a/src/llama-kv-cache.h
+++ b/src/llama-kv-cache.h
@@ -192,6 +192,28 @@ public:
 
     uint32_t get_n_kv(const slot_info & sinfo) const;
 
+    // sparse decode attention (Quest-style block selection), LLAMA_SPARSE_ATTN=k,bs,min_ctx[,sink,recent]
+    struct sparse_params {
+        int32_t k       = 0;      // selected blocks per query (0: off)
+        int32_t bs      = 64;     // cells per block
+        int32_t min_ctx = 16384;  // use sparse attention from this n_kv
+        int32_t sink    = 128;    // always keep blocks holding positions < sink
+        int32_t recent  = 1024;   // always keep blocks holding positions > pos_max - recent
+    };
+    const sparse_params & get_sparse() const { return sparse; }
