+    int64_t n_kv_max = 0;
+    if (!is_swa && inp->sp_bias) {
+        // Quest-style block selection: upper bound of q.k per block from the per-block key max/min,
+        // softmax per head over blocks, summed over all heads, top-k blocks (+ forced sink / recent blocks)
+        const auto & sp   = mctx_iswa->get_base()->get_kv()->get_sparse();
+        const int64_t bs    = sp.bs;
+        const int64_t n_kv  = kq_mask->ne[0];
+        const int64_t n_blk = n_kv / bs;
+        const int64_t n_tok = q_cur->ne[2];
+        const int64_t n_hd  = q_cur->ne[1];
+
+        ggml_tensor * ksv = mctx_iswa->get_base()->get_ks(ctx0, il);                // [2*hd, n_blk, n_head_kv]
+        GGML_ASSERT(ksv->ne[1] == n_blk);
+
+        ggml_tensor * qp = ggml_relu(ctx0, q_cur);
+        ggml_tensor * qn = ggml_neg(ctx0, ggml_relu(ctx0, ggml_neg(ctx0, q_cur)));
+        ggml_tensor * q2 = ggml_concat(ctx0, qp, qn, 0);                       // [2*hd, n_head, n_tok]
+        q2 = ggml_cont(ctx0, ggml_permute(ctx0, q2, 0, 2, 1, 3));              // [2*hd, n_tok, n_head]
+
+        ggml_tensor * ub = ggml_mul_mat(ctx0, ksv, q2);                        // [n_blk, n_tok, n_head]
+
+        ggml_tensor * bias_pre  = ggml_view_2d(ctx0, inp->sp_bias, n_blk, n_tok, inp->sp_bias->nb[1], 0);
+        ggml_tensor * bias_post = ggml_view_2d(ctx0, inp->sp_bias, n_blk, n_tok, inp->sp_bias->nb[1], inp->sp_bias->nb[2]);
+
+        ggml_tensor * pb = ggml_soft_max_ext(ctx0, ub, bias_pre, kq_scale, 0.0f);
+        pb = ggml_cont(ctx0, ggml_permute(ctx0, pb, 1, 2, 0, 3));              // [n_head, n_blk, n_tok]
+        pb = ggml_sum_rows(ctx0, pb);                                           // [1, n_blk, n_tok]
+        pb = ggml_reshape_2d(ctx0, pb, n_blk, n_tok);
+        pb = ggml_add(ctx0, pb, bias_post);
+
+        ggml_tensor * top = ggml_top_k(ctx0, pb, sp.k);                        // I32 [k, n_tok]
+
+        ggml_tensor * m_all = ggml_fill(ctx0, kq_mask, -INFINITY);
+        ggml_tensor * m_blk = ggml_view_3d(ctx0, m_all, bs, n_blk, n_tok, bs*ggml_element_size(m_all), m_all->nb[1], 0);
+        ggml_tensor * zeros = ggml_fill(ctx0, ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, bs, sp.k, n_tok), 0.0f);
+        ggml_tensor * m_sel = ggml_set_rows(ctx0, m_blk, zeros, top);
+        m_sel = ggml_view_2d(ctx0, m_sel, n_kv, n_tok, m_all->nb[1], 0);
+        kq_mask = ggml_add(ctx0, m_sel, kq_mask);
+        n_kv_max = (int64_t) sp.k * bs;
+        GGML_UNUSED(n_hd);
+    }
+
+    ggml_tensor * cur = build_attn_mha(q, k, v, kq_b, kq_mask, sinks, v_mla, n_kv_max, kq_scale, il);
     cb(cur, "kqv_out", il);
 
     if (v_rot) {
@@ -3737,6 +3797,12 @@ llm_graph_input_attn_kv_iswa * llm_graph_context::build_attn_inp_kv_iswa() const
