+// ggml_compute_forward_dsv4_hc_mix_partials
+
+void ggml_compute_forward_dsv4_hc_mix_partials(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * a = dst->src[0]; // hc_fn [K, m] q8_0
+    const ggml_tensor * x = dst->src[1]; // [n_embd, hc, n_tokens]
+
+    GGML_ASSERT(a->type == GGML_TYPE_Q8_0 && x->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(a) && ggml_is_contiguous(x));
+
+    constexpr int64_t tail = 32;
+    constexpr int64_t qk   = 32; // QK8_0
+
+    const int64_t K        = a->ne[0];
+    const int64_t m        = a->ne[1];
+    const int64_t n_tokens = x->ne[2];
+    const int64_t n_split  = ggml_get_op_params_i32(dst, 0);
+    const int64_t slice    = K / n_split;
+
+    struct blk_q8_0 { ggml_fp16_t d; int8_t qs[32]; }; // block_q8_0
+    static_assert(sizeof(blk_q8_0) == 34, "unexpected q8_0 block size");
+    const blk_q8_0 * wa = (const blk_q8_0 *) a->data;
+    const float      * xd = (const float *) x->data;
+    float            * d  = (float *) dst->data;
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    // one (slice, token) pair per job; same summation order as the Vulkan shader:
+    // per block sum(q*x) * d, then the blocks of the slice in order
+    for (int64_t job = ith; job < n_split*n_tokens; job += nth) {
+        const int64_t p  = job / n_tokens;
+        const int64_t it = job % n_tokens;
+        const float * xs = xd + it*K + p*slice;
+        float * out = d + (p*n_tokens + it)*tail;
+
+        for (int64_t row = 0; row < m; ++row) {
+            float acc = 0.0f;
+            for (int64_t b = 0; b < slice/qk; ++b) {
+                const blk_q8_0 * blk = wa + row*(K/qk) + p*(slice/qk) + b;
+                float s = 0.0f;
+                for (int64_t j = 0; j < qk; ++j) {
+                    s += (float) blk->qs[j] * xs[b*qk + j];
+                }
+                acc += s * GGML_CPU_FP16_TO_FP32(blk->d);
+            }
+            out[row] = acc;
+        }
+
+        float ss = 0.0f;
+        for (int64_t j = 0; j < slice; ++j) {
+            ss += xs[j]*xs[j];
+        }
+        out[m] = ss;
+        for (int64_t i = m + 1; i < tail; ++i) {
+            out[i] = 0.0f;
+        }
+    }
+}
