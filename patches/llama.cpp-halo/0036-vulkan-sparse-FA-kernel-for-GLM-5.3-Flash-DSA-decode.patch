+#version 450
+
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_shuffle : require
+
+#if defined(DOT2_F16)
+#extension GL_EXT_spirv_intrinsics : require
+spirv_instruction(extensions = ["SPV_VALVE_mixed_float_dot_product"], capabilities = [6912], id = 6916)
+float v_dot2_f32_f16(f16vec2 a, f16vec2 b, float acc);
+float dot2_acc(f16vec2 a, f16vec2 b, float acc) {
+    return v_dot2_f32_f16(a, b, acc);
+}
+#else
+float dot2_acc(f16vec2 a, f16vec2 b, float acc) {
+    return fma(float(a.x), float(b.x), fma(float(a.y), float(b.y), acc));
+}
+#endif
+
+float dot4_acc(f16vec4 a, f16vec4 b, float acc) {
+    return dot2_acc(a.zw, b.zw, dot2_acc(a.xy, b.xy, acc));
+}
+
+// Sparse flash attention for few query tokens per head with every query head on one KV head (GLM-5.3-Flash
+// DSA: MLA latent 512, 64 heads, 2048 selected positions per token). The selected positions come from the
+// compaction pass (flash_attn_sparse_compact.comp); with several splits the partial results go through the
+// split_k reduce, a single split writes dst itself.
+//
+// Workgroup (group of HG heads, token, split): it preloads its slice of the index list into shared memory,
+// keeps the scaled query heads in registers as f16 (as the other FA paths do) and walks the slice in blocks of
+// BC positions. Each block of K rows is gathered with 16-byte loads into registers one block ahead, so the
+// gather latency overlaps the math of the previous block, and all HG heads share the staged block.
+// With V a view of K, P*V reads the staged rows too. S, softmax and O are fp32, P is f16 (as in the other FA
+// paths) so P*V runs on 2-wide f16 dot products with fp32 accumulation.
+
+layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
+
+layout(constant_id = 0) const uint V_SAME = 1;       // V rows are the K rows
+
+// sizes are plain constants (not specialization constants) so every array has a literal size
+#define D         512u  // HSK == HSV
+#define MAX_SLOTS 2304u // largest index slice per workgroup (GLM: 2048 + 3 tail slots, rounded up to blocks)
+#define WG  512u
+#define HG  32u    // heads per workgroup
+#define BC  32u    // positions per block
+#define DS  8u     // lanes that split the dims of one dot product in S = Q K^T
+#define KPT 8u     // positions per invocation in S = Q K^T (two heads each)
+
+#define D4  (D / 4u)
+#define D8  (D / 8u)
+#define KS4 (D4 + 8u)  // padded row stride of the staged K block, in f16vec4
+#define RPI (WG / D8)  // rows per gather iteration
+#define NIT (BC / RPI) // gather iterations per block
+#define PVH (WG / (D / 4u)) // head groups in P*V: an invocation owns 4 dims of HPV heads
+#define HPV (HG / PVH)
+
+layout(binding = 0) readonly buffer Q {vec4 data_q4[];};
+layout(binding = 1) readonly buffer K {uvec4 data_k8[];};
+layout(binding = 2) readonly buffer V {f16vec4 data_v4[];};
+layout(binding = 3) readonly buffer M {float16_t data_m[];};
+layout(binding = 4) readonly buffer I {int data_i[];};
+layout(binding = 5) writeonly buffer O {float data_o[];};
+layout(binding = 5) writeonly buffer O4 {vec4 data_o4[];};
+
+layout(push_constant) uniform parameter {
+    uint N;          // query tokens
+    uint n_kv_max;   // index slots per token
+    uint k_num;      // splits
+    uint per_blocks; // blocks per split
+    uint q_nb1;      // token stride of q, floats
+    uint q_nb2;      // head stride of q, floats
+    uint k_stride;   // row stride of K, f16
+    uint v_stride;   // row stride of V, f16
+    uint m_stride;   // row stride of the mask, f16
+    uint ne1;        // number of heads
+    float scale;
+} p;
+
+shared f16vec4  ksh[BC * KS4];
+shared float    ssh[BC * HG];        // S, [position][head]
+shared uvec4    psh[BC / 2 * HG / 4]; // P as packed f16 pairs, [position pair][head]
+shared float    msh[BC];
+shared float    esh[HG];
+shared int      idxsh[MAX_SLOTS];
+
+const float NEG = uintBitsToFloat(0xFEFFFFFF); // -FLT_MAX/2
+
+void main() {
+    // head group fastest, then token: the workgroups that gather the same (or, for neighbouring tokens, mostly
+    // the same) K rows run next to each other and share them through the cache
+    const uint tid   = gl_LocalInvocationIndex;
+    const uint h0    = gl_WorkGroupID.x * HG;
+    const uint t     = gl_WorkGroupID.y;
+    const uint split = gl_WorkGroupID.z;
+
+    const uint total_blocks = (p.n_kv_max + BC - 1) / BC;
+    const uint b_begin = min(split * p.per_blocks, total_blocks);
+    const uint b_end   = min(b_begin + p.per_blocks, total_blocks);
+    const uint n_blk   = b_end - b_begin;
+    const uint slot0   = b_begin * BC;
+
+    // the slice of the index list, -1 past n_kv_max
+    for (uint s = tid; s < n_blk * BC; s += WG) {
+        const uint slot = slot0 + s;
+        idxsh[s] = slot < p.n_kv_max ? data_i[t * p.n_kv_max + slot] : -1;
+    }
+
+    // S = Q K^T: each group of 32 invocations owns a head pair (qk_hp), DS lanes split the dims and the 4 lane
+    // groups (qk_kg) take every 4th position, so the rows they read sit in different banks.
+    // Each invocation keeps its share of the two scaled query heads in registers.
+    const uint qk_hp = tid / 32;
+    const uint qk_kg = (tid / DS) % 4;
+    const uint qk_ds = tid % DS;
+
+    f16vec4 qr[2][D4 / DS];
+    [[unroll]] for (uint hh = 0; hh < 2; ++hh) {
+        const uint qb = (t * p.q_nb1 + (h0 + 2 * qk_hp + hh) * p.q_nb2) / 4;
+        [[unroll]] for (uint i = 0; i < D4 / DS; ++i) {
+            qr[hh][i] = f16vec4(data_q4[qb + qk_ds + DS * i] * p.scale);
+        }
+    }
+    barrier();
+
+    // gather layout: rows r = it * RPI + tid / D8, 16-byte column tid % D8
+    const uint gc8 = tid % D8;
+    const uint gr0 = tid / D8;
+
+    uvec4 kreg[NIT];
+    float mreg = NEG;
+
+    // prefetch block 0
+    if (n_blk > 0) {
+        [[unroll]] for (uint it = 0; it < NIT; ++it) {
+            const int idx = idxsh[it * RPI + gr0];
+            kreg[it] = idx >= 0 ? data_k8[(uint(idx) * p.k_stride) / 8 + gc8] : uvec4(0);
+        }
+        if (tid < BC) {
+            const int idx = idxsh[tid];
+            mreg = idx >= 0 ? float(data_m[t * p.m_stride + uint(idx)]) : NEG;
+        }
+    }
+
+    // softmax: 16 lanes per head, each takes the adjacent positions 2*sm_c and 2*sm_c+1
+    const uint sm_h = tid / 16;
+    const uint sm_c = tid % 16;
+    float Mh = NEG;
+    float Lh = 0.0;
+
+    // P*V: this invocation owns dims 4*pv_d .. 4*pv_d+3 of heads pv_hh*HPV .. pv_hh*HPV + HPV-1
+    const uint pv_d  = tid % (D / 4);
+    const uint pv_hh = tid / (D / 4);
+    vec4 Of[HPV];
+    [[unroll]] for (uint h = 0; h < HPV; ++h) {
+        Of[h] = vec4(0.0);
+    }
+
+    for (uint b = 0; b < n_blk; ++b) {
+        barrier(); // the previous block is consumed
+
+        [[unroll]] for (uint it = 0; it < NIT; ++it) {
+            const uint r = it * RPI + gr0;
+            const uvec4 u = kreg[it];
+            ksh[r * KS4 + 2 * gc8    ] = f16vec4(unpackFloat2x16(u.x), unpackFloat2x16(u.y));
+            ksh[r * KS4 + 2 * gc8 + 1] = f16vec4(unpackFloat2x16(u.z), unpackFloat2x16(u.w));
+        }
+        if (tid < BC) {
+            msh[tid] = mreg;
+        }
+        barrier();
+
+        // prefetch the next block, it lands while this one is computed
+        if (b + 1 < n_blk) {
+            [[unroll]] for (uint it = 0; it < NIT; ++it) {
+                const int idx = idxsh[(b + 1) * BC + it * RPI + gr0];
+                kreg[it] = idx >= 0 ? data_k8[(uint(idx) * p.k_stride) / 8 + gc8] : uvec4(0);
+            }
+            if (tid < BC) {
+                const int idx = idxsh[(b + 1) * BC + tid];
+                mreg = idx >= 0 ? float(data_m[t * p.m_stride + uint(idx)]) : NEG;
+            }
+        }
+
+        // acc[hh * KPT + c]: head 2*qk_hp + hh, position c*4 + qk_kg
+        float acc[2 * KPT];
+        [[unroll]] for (uint j = 0; j < 2 * KPT; ++j) {
+            acc[j] = 0.0;
+        }
+        [[unroll]] for (uint i = 0; i < D4 / DS; ++i) {
+            [[unroll]] for (uint c = 0; c < KPT; ++c) {
+                const f16vec4 kv = ksh[(c * 4 + qk_kg) * KS4 + qk_ds + DS * i];
+                acc[c]       = dot4_acc(qr[0][i], kv, acc[c]);
+                acc[KPT + c] = dot4_acc(qr[1][i], kv, acc[KPT + c]);
+            }
+        }
+
+        // transpose-reduce over the DS lanes: lane ds ends up with acc[2*ds] and acc[2*ds+1] summed
+        float r8[8];
+        {
+            const bool hi = (qk_ds & 4) != 0;
+            [[unroll]] for (uint k = 0; k < 8; ++k) {
+                const float mine  = hi ? acc[8 + k] : acc[k];
+                const float other = hi ? acc[k] : acc[8 + k];
+                r8[k] = mine + subgroupShuffleXor(other, 4);
+            }
+        }
+        float r4[4];
+        {
+            const bool hi = (qk_ds & 2) != 0;
+            [[unroll]] for (uint k = 0; k < 4; ++k) {
+                const float mine  = hi ? r8[4 + k] : r8[k];
+                const float other = hi ? r8[k] : r8[4 + k];
+                r4[k] = mine + subgroupShuffleXor(other, 2);
+            }
+        }
+        float r2[2];
+        {
+            const bool hi = (qk_ds & 1) != 0;
+            [[unroll]] for (uint k = 0; k < 2; ++k) {
+                const float mine  = hi ? r4[2 + k] : r4[k];
+                const float other = hi ? r4[k] : r4[2 + k];
+                r2[k] = mine + subgroupShuffleXor(other, 1);
+            }
+        }
+        {
+            // acc index 2*ds (+1) -> head 2*qk_hp + ds/4, positions (2*(ds%4) (+1))*4 + qk_kg
+            const uint h  = 2 * qk_hp + qk_ds / 4;
+            const uint c0 = (2 * (qk_ds % 4)    ) * 4 + qk_kg;
+            const uint c1 = (2 * (qk_ds % 4) + 1) * 4 + qk_kg;
+            const float m0 = msh[c0];
+            const float m1 = msh[c1];
+            ssh[c0 * HG + h] = m0 <= NEG ? NEG : r2[0] + m0;
+            ssh[c1 * HG + h] = m1 <= NEG ? NEG : r2[1] + m1;
+        }
+        barrier();
+
+        // online softmax
+        {
+            const float s0 = ssh[(2 * sm_c    ) * HG + sm_h];
+            const float s1 = ssh[(2 * sm_c + 1) * HG + sm_h];
+            float bmax = max(s0, s1);
+            [[unroll]] for (uint o = 8; o > 0; o >>= 1) {
+                bmax = max(bmax, subgroupShuffleXor(bmax, o));
+            }
+            const float Mnew = max(Mh, bmax);
+            const float p0 = s0 <= NEG ? 0.0 : exp(s0 - Mnew);
+            const float p1 = s1 <= NEG ? 0.0 : exp(s1 - Mnew);
+            psh[sm_c * (HG / 4) + sm_h / 4][sm_h % 4] = packFloat2x16(f16vec2(p0, p1));
+            float ls = p0 + p1;
+            [[unroll]] for (uint o = 8; o > 0; o >>= 1) {
+                ls += subgroupShuffleXor(ls, o);
+            }
+            const float eM = exp(Mh - Mnew);
+            Lh = Lh * eM + ls;
+            Mh = Mnew;
+            if (sm_c == 0) {
+                esh[sm_h] = eM;
+            }
+        }
+        barrier();
+
+        [[unroll]] for (uint h = 0; h < HPV; ++h) {
+            Of[h] *= esh[pv_hh * HPV + h];
+        }
+        [[unroll]] for (uint cp = 0; cp < BC / 2; ++cp) {
+            f16vec4 va, vb; // dims 4*pv_d .. 4*pv_d+3 of positions 2*cp and 2*cp+1
+            if (V_SAME != 0) {
+                va = ksh[(2 * cp    ) * KS4 + pv_d];
+                vb = ksh[(2 * cp + 1) * KS4 + pv_d];
+            } else {
+                const int ia = idxsh[b * BC + 2 * cp];
+                const int ib = idxsh[b * BC + 2 * cp + 1];
+                va = ia >= 0 ? data_v4[(uint(ia) * p.v_stride) / 4 + pv_d] : f16vec4(0.0);
+                vb = ib >= 0 ? data_v4[(uint(ib) * p.v_stride) / 4 + pv_d] : f16vec4(0.0);
+            }
+            const f16vec2 vx = f16vec2(va.x, vb.x);
+            const f16vec2 vy = f16vec2(va.y, vb.y);
+            const f16vec2 vz = f16vec2(va.z, vb.z);
+            const f16vec2 vw = f16vec2(va.w, vb.w);
+            [[unroll]] for (uint h4 = 0; h4 < HPV / 4; ++h4) {
+                const uvec4 pk = psh[cp * (HG / 4) + pv_hh * (HPV / 4) + h4];
+                [[unroll]] for (uint k = 0; k < 4; ++k) {
+                    const f16vec2 pp = unpackFloat2x16(pk[k]);
+                    const uint h = 4 * h4 + k;
+                    Of[h].x = dot2_acc(pp, vx, Of[h].x);
+                    Of[h].y = dot2_acc(pp, vy, Of[h].y);
+                    Of[h].z = dot2_acc(pp, vz, Of[h].z);
+                    Of[h].w = dot2_acc(pp, vw, Of[h].w);
+                }
+            }
+        }
+    }
+
+    if (p.k_num == 1) {
+        // single split: normalize and write dst [D, ne1, N] directly
+        barrier();
+        if (sm_c == 0) {
+            esh[sm_h] = Lh == 0.0 ? 0.0 : 1.0 / Lh;
+        }
+        barrier();
+        const uint d_base = (t * p.ne1 + h0 + pv_hh * HPV) * D;
+        [[unroll]] for (uint h = 0; h < HPV; ++h) {
+            data_o4[(d_base + h * D) / 4 + pv_d] = Of[h] * esh[pv_hh * HPV + h];
+        }
+        return;
+    }
+
+    // split_k partials, same layout as the FA shaders with a gqa fold (heads in place of rows)
+    const uint o_base = D * p.ne1 * (split + p.k_num * t) + (h0 + pv_hh * HPV) * D;
+    [[unroll]] for (uint h = 0; h < HPV; ++h) {
+        data_o4[(o_base + h * D) / 4 + pv_d] = Of[h];
+    }
+    if (sm_c == 0) {
+        const uint lm_base = D * p.ne1 * p.k_num * p.N + p.ne1 * 2 * (split + p.k_num * t);
+        data_o[lm_base + h0 + sm_h]         = Lh;
+        data_o[lm_base + p.ne1 + h0 + sm_h] = Mh;
+    }
+}
