+static bool ggml_vk_flash_attn_sparse_dec(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_tensor * q, const ggml_tensor * k, const ggml_tensor * v, const ggml_tensor * mask, const ggml_tensor * sinks, ggml_tensor * dst) {
+    static const bool disabled = getenv("GGML_VK_FA_SPARSE_DEC_DISABLE") != nullptr || getenv("GGML_VK_FA_SPARSE_DISABLE") != nullptr;
+    // GGML_VK_FA_SPARSE_DEC_MAX_N: largest batch that takes this path (default: any)
+    static const uint32_t max_n = getenv("GGML_VK_FA_SPARSE_DEC_MAX_N") ? (uint32_t)atoi(getenv("GGML_VK_FA_SPARSE_DEC_MAX_N")) : UINT32_MAX;
+    constexpr uint32_t HG = 32, BC = 32, D = 512, MAX_SLOTS = 2304;
+
+    if (disabled || !mask || sinks || ctx->device->pipeline_fa_sparse_dec[0] == nullptr) {
+        return false;
+    }
+    const int32_t n_kv_max = ggml_get_op_params_i32(dst, 4);
+    float scale, max_bias, logit_softcap;
+    memcpy(&scale,         (const float *) dst->op_params + 0, sizeof(float));
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+
+    const uint32_t N  = q->ne[1];
+    const uint32_t H  = q->ne[2];
+    const uint32_t KV = k->ne[1];
+
+    const bool v_same = v->data == k->data && v->nb[1] == k->nb[1];
+    if (n_kv_max <= 0 || max_bias != 0.0f || logit_softcap != 0.0f ||
+        q->type != GGML_TYPE_F32 || k->type != GGML_TYPE_F16 || v->type != GGML_TYPE_F16 || mask->type != GGML_TYPE_F16 ||
+        k->ne[0] != D || v->ne[0] != D || N == 0 || N > max_n || H % HG != 0 ||
+        k->ne[2] != 1 || v->ne[2] != 1 || q->ne[3] != 1 || k->ne[3] != 1 || v->ne[3] != 1 ||
+        mask->ne[0] != KV || mask->ne[1] < N || mask->ne[2] != 1 || mask->ne[3] != 1 ||
+        (int64_t)KV < std::max<int64_t>(4096, 2 * (int64_t)n_kv_max) ||
+        q->nb[1] % 16 != 0 || q->nb[2] % 16 != 0 || k->nb[1] % 16 != 0 || v->nb[1] % 8 != 0 || mask->nb[1] % 2 != 0 ||
+        !ggml_is_contiguous(dst) || dst->ne[1] != H || dst->ne[2] != N) {
+        return false;
+    }
+
+    // splits: one round of workgroups, about one per shader core (a workgroup takes ~51 KB of shared memory and
+    // 512 invocations, so only one fits per core), at most MAX_SLOTS index slots per workgroup. A single split
+    // writes dst directly; the split partials of large batches would not fit the split_k scratch.
+    // GGML_VK_FA_SPARSE_DEC_WGS overrides the target workgroup count.
+    static const uint32_t target_wgs_env = getenv("GGML_VK_FA_SPARSE_DEC_WGS") ? (uint32_t)atoi(getenv("GGML_VK_FA_SPARSE_DEC_WGS")) : 0;
+    const uint32_t target_wgs = target_wgs_env ? target_wgs_env : (ctx->device->shader_core_count ? ctx->device->shader_core_count : 16);
+    const uint32_t total_blocks = CEIL_DIV((uint32_t)n_kv_max, BC);
+    const uint32_t base_wgs = (H / HG) * N;
+    uint32_t k_num = std::max(std::max(1u, target_wgs / base_wgs), CEIL_DIV((uint32_t)n_kv_max, MAX_SLOTS));
+    k_num = std::min(k_num, total_blocks);
+    uint32_t per_blocks = CEIL_DIV(total_blocks, k_num);
+    k_num = CEIL_DIV(total_blocks, per_blocks);
+    if (k_num > 1 && (uint64_t)(D * H * sizeof(float) + H * sizeof(float) * 2) * k_num * N > 64ull * 1024 * 1024) {
+        k_num = 1;
+        per_blocks = total_blocks;
+    }
+    if (per_blocks * BC > MAX_SLOTS) {
+        return false;
+    }
+
+    vk_pipeline pipeline = ctx->device->pipeline_fa_sparse_dec[v_same ? 1 : 0];
+    vk_pipeline compact = ctx->device->fa_sparse_compact_use_subgroups ? ctx->device->pipeline_fa_sparse_compact_subgroup
+                                                                       : ctx->device->pipeline_fa_sparse_compact;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+    ggml_pipeline_request_descriptor_sets(ctx, compact, 1);
+    ggml_pipeline_request_descriptor_sets(ctx, ctx->device->pipeline_flash_attn_split_k_reduce, 1);
+
+    const uint32_t nem1 = mask->ne[1];
+    const uint64_t sparse_idx_size = sizeof(int32_t) * (uint64_t)n_kv_max * nem1;
+    if (ctx->prealloc_size_y < sparse_idx_size) {
+        ctx->prealloc_size_y = sparse_idx_size;
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    }
+    const uint64_t split_k_size = k_num > 1 ? (uint64_t)(D * H * sizeof(float) + H * sizeof(float) * 2) * k_num * N : 0;
+    if (ctx->prealloc_size_split_k < split_k_size) {
+        ctx->prealloc_size_split_k = split_k_size;
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    }
+    if (ctx->prealloc_y_need_sync || ctx->prealloc_split_k_need_sync) {
+        ggml_vk_sync_buffers(ctx, subctx);
+    }
+
+    vk_subbuffer q_buf    = ggml_vk_tensor_subbuffer(ctx, q);
+    vk_subbuffer k_buf    = ggml_vk_tensor_subbuffer(ctx, k);
+    vk_subbuffer v_buf    = v_same ? k_buf : ggml_vk_tensor_subbuffer(ctx, v);
+    vk_subbuffer mask_buf = ggml_vk_tensor_subbuffer(ctx, mask);
+    vk_subbuffer dst_buf  = ggml_vk_tensor_subbuffer(ctx, dst);
+    vk_subbuffer idx_buf  = ggml_vk_subbuffer(ctx, ctx->prealloc_y, 0);
+    vk_subbuffer part_buf = ggml_vk_subbuffer(ctx, ctx->prealloc_split_k, 0);
+    // the index list overwrites a matmul input converted into prealloc_y
+    ctx->prealloc_y_last_pipeline_used = nullptr;
+    ctx->prealloc_y_last_tensor_used = nullptr;
+
+    const vk_op_flash_attn_sparse_compact_push_constants sc_pc = {
+        KV, nem1, 1,
+        (uint32_t)(mask->nb[1] / sizeof(ggml_fp16_t)),
+        (uint32_t)(mask->nb[2] / sizeof(ggml_fp16_t)),
+        (uint32_t)(mask->nb[3] / sizeof(ggml_fp16_t)),
+        (uint32_t)n_kv_max,
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, compact, { mask_buf, idx_buf }, sc_pc, { nem1, 1, 1 });
+    ggml_vk_sync_buffers(ctx, subctx);
+
+    const vk_op_flash_attn_sparse_dec_push_constants pc = {
+        N, (uint32_t)n_kv_max, k_num, per_blocks,
+        (uint32_t)(q->nb[1] / sizeof(float)), (uint32_t)(q->nb[2] / sizeof(float)),
+        (uint32_t)(k->nb[1] / sizeof(ggml_fp16_t)), (uint32_t)(v->nb[1] / sizeof(ggml_fp16_t)),
+        (uint32_t)(mask->nb[1] / sizeof(ggml_fp16_t)),
+        H, scale,
+    };
+    if (k_num == 1) {
+        ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { q_buf, k_buf, v_buf, mask_buf, idx_buf, dst_buf }, pc, { H / HG, N, 1 });
+    } else {
+        ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { q_buf, k_buf, v_buf, mask_buf, idx_buf, part_buf }, pc, { H / HG, N, k_num });
+        ggml_vk_sync_buffers(ctx, subctx);
+
+        const vk_op_flash_attn_split_k_reduce_push_constants pc2 = { D, H, N, 1, k_num, 0 };
+        ggml_vk_dispatch_pipeline(ctx, subctx, ctx->device->pipeline_flash_attn_split_k_reduce,
+                                  { part_buf, q_buf, dst_buf }, pc2, { H, D, N });
+        ctx->prealloc_split_k_need_sync = true;
+    }
+
+    ctx->prealloc_y_need_sync = true;
+    return true;
+}
