 LLAMA_API void llama_set_nextn_layer_offset(struct llama_context * ctx, int32_t offset);
 
+// Restrict the output head of an MTP draft context to a token subset (FR-Spec style draft vocabulary): the head
+// reads only the rows of `ids` and every other logit is -inf, so a draft never proposes a token outside the
+// subset. The target model's verification is unchanged. n_ids == 0 restores the full head.
+// Returns false (and keeps the full head) if the model's MTP graph does not support it or the ids are invalid.
+LLAMA_API bool llama_set_draft_vocab(struct llama_context * ctx, const llama_token * ids, int32_t n_ids);
+
 // Marks the entries that a decision head (clef, vllm-decision2) reads, the default is 0
 // See https://github.com/ggml-org/llama.cpp/pull/29831 for details
 // A run of entries with the same value is one span, spans must be separated by entries with value 0
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index f69fe63f8..c9f89ef15 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1612,6 +1612,32 @@ ggml_tensor * llm_graph_context::build_hadamard_input(
     return x;
 }
 
+ggml_tensor * llm_graph_context::build_mtp_head(
+          ggml_tensor * w,
+          ggml_tensor * cur,
+          ggml_tensor * w_s) const {
+    if (cparams.dvocab_head == nullptr || w_s != nullptr || !loras->empty()) {
+        return build_lora_mm(w, cur, w_s);
+    }
+
+    const int64_t n_sub   = cparams.dvocab_head->ne[1];
+    const int64_t n_vocab = cparams.dvocab_inv->ne[0];
+    const int64_t n_rows  = cur->ne[1];
+    GGML_ASSERT(n_vocab == w->ne[1] && cparams.dvocab_head->ne[0] == w->ne[0]);
+
+    cur = build_hadamard_input(w, cur); // the subset rows are rows of w: same input basis
+    ggml_tensor * sub = ggml_mul_mat(ctx0, cparams.dvocab_head, cur); // [n_sub, n_rows]
+    if (prec_policy) {
+        prec_policy->apply(sub);
+    }
+    cb(sub, "result_output_dvocab", -1);
+
+    sub = n_rows == 1 ? ggml_reshape_2d(ctx0, sub, 1, n_sub) : ggml_cont(ctx0, ggml_transpose(ctx0, sub));
+    cur = ggml_get_rows(ctx0, sub, cparams.dvocab_inv); // [n_rows, n_vocab]
+    cur = n_rows == 1 ? ggml_reshape_2d(ctx0, cur, n_vocab, 1) : ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+    return ggml_add(ctx0, cur, cparams.dvocab_mask);
+}
