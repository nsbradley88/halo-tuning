+bool llama_context::set_draft_vocab(const llama_token * ids, int32_t n_ids) {
+    synchronize();
+
+    cparams.dvocab_head = nullptr;
+    cparams.dvocab_inv  = nullptr;
+    cparams.dvocab_mask = nullptr;
+    dvocab_buf.reset();
+    dvocab_ctx.reset();
+    sched_need_reserve = true;
+
+    if (n_ids <= 0) {
+        return true;
+    }
+
+    if (cparams.ctx_type != LLAMA_CONTEXT_TYPE_MTP || (model.arch != LLM_ARCH_QWEN35 && model.arch != LLM_ARCH_QWEN35MOE) || model.hparams.n_layer_nextn == 0) {
+        LLAMA_LOG_WARN("%s: the draft vocabulary is only supported for Qwen3.5 / Qwen3.5-MoE MTP draft contexts\n", __func__);
+        return false;
+    }
+
+    const auto & nextn = model.layers[model.hparams.n_layer()].nextn;
+    ggml_tensor * head = nextn.shared_head_head ? nextn.shared_head_head : model.output;
+    if (head == nullptr || head->buffer == nullptr || model.output_s != nullptr || nextn.shared_head_head_s != nullptr) {
+        LLAMA_LOG_WARN("%s: unsupported output head\n", __func__);
+        return false;
+    }
+
+    const int64_t n_vocab = head->ne[1];
+    const int64_t n_embd  = head->ne[0];
+
+    std::vector<llama_token> sub(ids, ids + n_ids);
+    std::sort(sub.begin(), sub.end());
+    sub.erase(std::unique(sub.begin(), sub.end()), sub.end());
+    if (sub.front() < 0 || sub.back() >= n_vocab) {
+        LLAMA_LOG_WARN("%s: token id out of range [0, %" PRId64 ")\n", __func__, n_vocab);
+        return false;
+    }
+    const int64_t n_sub = (int64_t) sub.size();
+
+    ggml_init_params ip = {
+        /*.mem_size   =*/ 3 * ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    dvocab_ctx.reset(ggml_init(ip));
+    ggml_tensor * t_head = ggml_new_tensor_2d(dvocab_ctx.get(), head->type, n_embd, n_sub);
+    ggml_tensor * t_inv  = ggml_new_tensor_1d(dvocab_ctx.get(), GGML_TYPE_I32, n_vocab);
+    ggml_tensor * t_mask = ggml_new_tensor_1d(dvocab_ctx.get(), GGML_TYPE_F32, n_vocab);
+    ggml_set_name(t_head, "dvocab_head");
+    ggml_set_name(t_inv,  "dvocab_inv");
+    ggml_set_name(t_mask, "dvocab_mask");
+
+    ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(head->buffer);
+    dvocab_buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(dvocab_ctx.get(), buft));
+    if (!dvocab_buf) {
+        LLAMA_LOG_WARN("%s: failed to allocate the draft head\n", __func__);
+        dvocab_ctx.reset();
+        return false;
+    }
+    ggml_backend_buffer_set_usage(dvocab_buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    // gather the head rows, reading the source in chunks of rows
+    const size_t row_size = ggml_row_size(head->type, n_embd);
+    GGML_ASSERT(head->nb[1] == row_size);
+    const int64_t chunk = std::max<int64_t>(1, (int64_t) ((32u << 20) / row_size));
+    std::vector<uint8_t> src_rows;
+    std::vector<uint8_t> dst_rows((size_t) n_sub * row_size);
+    size_t i_sub = 0;
+    for (int64_t r0 = 0; r0 < n_vocab && i_sub < sub.size(); r0 += chunk) {
+        const int64_t r1 = std::min(n_vocab, r0 + chunk);
+        if (sub[i_sub] >= r1) {
+            continue;
+        }
+        src_rows.resize((size_t) (r1 - r0) * row_size);
+        ggml_backend_tensor_get(head, src_rows.data(), (size_t) r0 * row_size, src_rows.size());
+        while (i_sub < sub.size() && sub[i_sub] < r1) {
+            memcpy(dst_rows.data() + i_sub * row_size, src_rows.data() + (size_t) (sub[i_sub] - r0) * row_size, row_size);
+            ++i_sub;
+        }
+    }
+    ggml_backend_tensor_set(t_head, dst_rows.data(), 0, dst_rows.size());
+
+    std::vector<int32_t> inv(n_vocab, 0);
+    std::vector<float>   mask(n_vocab, -INFINITY);
+    for (int64_t i = 0; i < n_sub; ++i) {
+        inv[sub[i]]  = (int32_t) i;
+        mask[sub[i]] = 0.0f;
+    }
+    ggml_backend_tensor_set(t_inv,  inv.data(),  0, inv.size()  * sizeof(int32_t));
+    ggml_backend_tensor_set(t_mask, mask.data(), 0, mask.size() * sizeof(float));
+
+    cparams.dvocab_head = t_head;
+    cparams.dvocab_inv  = t_inv;
+    cparams.dvocab_mask = t_mask;
+
+    LLAMA_LOG_INFO("%s: draft head over %" PRId64 " of %" PRId64 " tokens (%.1f MiB, %s)\n", __func__, n_sub, n_vocab,
+            dst_rows.size() / 1048576.0, ggml_backend_buffer_name(dvocab_buf.get()));
+    return true;
+}
