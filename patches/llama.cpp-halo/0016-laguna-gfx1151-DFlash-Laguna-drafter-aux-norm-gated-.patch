 #ifndef FLASH_ATTN_AVAILABLE
     GGML_UNUSED(device); GGML_UNUSED(dst);
     return BEST_FATTN_KERNEL_NONE;
@@ -718,6 +718,19 @@ static best_fattn_kernel ggml_cuda_get_best_fattn_kernel(const int device, const
     return BEST_FATTN_KERNEL_TILE;
 }
 
+// local A/B (laguna-gfx1151): GGML_FATTN_DECODE=vec|mma|tile overrides the kernel chosen for single-token decode
+static best_fattn_kernel ggml_cuda_get_best_fattn_kernel(const int device, const ggml_tensor * dst) {
+    const best_fattn_kernel k = ggml_cuda_get_best_fattn_kernel_impl(device, dst);
+    static const char * ov = getenv("GGML_FATTN_DECODE");
+    if (ov == nullptr || k == BEST_FATTN_KERNEL_NONE || dst->src[0]->ne[1] != 1) {
+        return k;
+    }
+    if (strcmp(ov, "vec") == 0)  { return BEST_FATTN_KERNEL_VEC; }
+    if (strcmp(ov, "mma") == 0)  { return BEST_FATTN_KERNEL_MMA_F16; }
+    if (strcmp(ov, "tile") == 0) { return BEST_FATTN_KERNEL_TILE; }
+    return k;
+}
