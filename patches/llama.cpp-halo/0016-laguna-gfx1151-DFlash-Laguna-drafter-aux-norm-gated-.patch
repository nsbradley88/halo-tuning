 #include "llama-kv-cache.h"
 #include "llama-kv-cache-iswa.h"
 
+// Laguna DFlash: RMS-normalise each target layer's slice of the fc input with its own weight (enc.aux_norm, one
+// [n_embd_target] row per tapped layer) before the projection. No-op for drafts without the tensor.
+static ggml_tensor * dflash_aux_norm(ggml_context * ctx, const llama_model & model, float eps, ggml_tensor * x) {
+    if (model.enc_aux_norm == nullptr) {
+        return x;
+    }
+    const int64_t d = model.enc_aux_norm->ne[0];
+    const int64_t n = model.enc_aux_norm->ne[1];
+    const int64_t t = ggml_nelements(x) / (d * n);
+    if (!ggml_is_contiguous(x)) {
+        x = ggml_cont(ctx, x);
+    }
+    x = ggml_reshape_3d(ctx, x, d, n, t);
+    x = ggml_rms_norm(ctx, x, eps);
+    x = ggml_mul(ctx, x, model.enc_aux_norm);
+    return ggml_reshape_2d(ctx, x, d * n, t);
+}
