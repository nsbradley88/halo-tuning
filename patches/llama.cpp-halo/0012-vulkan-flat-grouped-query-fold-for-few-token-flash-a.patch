 // head, KV slices), so concurrent workgroups read all heads of the same tokens. For a KV cache that interleaves
 // the heads per token this reads whole token rows instead of one head's part of each row.
 #define KV_HEAD_INNER_BIT (1<<26)
+// Flat grouped-query fold (coopmat1, few query rows: decode and speculative verify batches): the row tiles of a
+// workgroup run over the flattened (token, query head) rows of one KV head, row R -> token R / gqa_ratio and query
+// head iq2 + R % gqa_ratio, so all tokens of a batch share one pass over K/V instead of one pass per token.
+// N is the number of flattened rows (tokens * gqa_ratio).
+#define GQA_FLAT_BIT (1<<27)
 #define N_LOG2_MASK 0xFFFF
 
 layout (binding = 4) readonly buffer S {float data_s[];};
@@ -189,7 +194,12 @@ void init_indices()
         }
         split_outer_iq2 = kv_head * heads_per_kv + q_sub;
     } else if (p.k_num > 1) {
-        if (p.gqa_ratio > 1) {
+        if ((p.mask_n_head_log2 & GQA_FLAT_BIT) != 0) {
+            // row tiles and split_k share gl_WorkGroupID.x
+            gqa_iq1 = 0;
+            split_k_index = gl_WorkGroupID.x % p.k_num;
+            i = gl_WorkGroupID.x / p.k_num;
+        } else if (p.gqa_ratio > 1) {
             i = 0;
             // batch and split_k share gl_WorkGroupID.x
             gqa_iq1 = gl_WorkGroupID.x / p.k_num;
@@ -199,6 +209,10 @@ void init_indices()
             split_k_index = gl_WorkGroupID.x % p.k_num;
             i = gl_WorkGroupID.x / p.k_num;
         }
+    } else if ((p.mask_n_head_log2 & GQA_FLAT_BIT) != 0) {
+        i = gl_WorkGroupID.x;
+        gqa_iq1 = 0;
+        split_k_index = 0;
     } else if (p.gqa_ratio > 1) {
         i = 0;
         gqa_iq1 = gl_WorkGroupID.x;
@@ -262,6 +276,34 @@ void init_indices()
     }
 }
 
+bool gqa_flat() {
+    return (p.mask_n_head_log2 & GQA_FLAT_BIT) != 0;
+}
+
+// Offset (in Q elements, from q_offset) of the tile-global row R.
+uint32_t q_row_offset(const uint32_t R) {
+    if (gqa_flat()) {
+        return (R / p.gqa_ratio) * p.nb01 + (R % p.gqa_ratio) * q_stride;
+    }
+    return R * q_stride;
+}
+
+// Offset (in mask elements, from m_offset) of the mask row of the tile-global row R.
+uint32_t m_row_offset(const uint32_t R) {
+    if (gqa_flat()) {
+        return min(R / p.gqa_ratio, p.nem1 - 1) * KV;
+    }
+    return R * m_stride;
+}
+
+// Grouped modes: the token (dst dim 2) and the query head offset from iq2 of the tile-global row R.
+uint32_t gqa_row_token(const uint32_t R) {
+    return gqa_flat() ? R / p.gqa_ratio : gqa_iq1;
+}
+uint32_t gqa_row_head(const uint32_t R) {
+    return gqa_flat() ? R % p.gqa_ratio : R;
+}
