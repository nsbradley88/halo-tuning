+// Small ubatches (decode, MTP verify/draft): Q, K and V share one conv window tensor, so the conv states are
+// concatenated once and each rollback group is a single copy for all three (instead of one per Q/K/V).
+// The three conv states of a cell are stored back to back, [d_conv - 1, 3*d_inner].
+static void glm5_conv1d_qkv(ggml_cgraph * gf, ggml_context * ctx0,
+                            ggml_tensor * conv_states_all, ggml_tensor * conv_state_all,
+                            ggml_tensor * x, ggml_tensor * const proj_w[3], ggml_tensor * const conv_w[3],
+                            int64_t d_conv, int64_t head_dim, int64_t n_head,
+                            int64_t n_seq_tokens, int64_t n_seqs, int64_t kv_head,
+                            int64_t mem_size, int64_t K_rs, ggml_tensor * out[3]) {
+    const int64_t d_inner         = head_dim * n_head;
+    const int64_t conv_state_size = (d_conv - 1) * d_inner;
+    const int64_t n_embd_r_total  = 3 * conv_state_size;
+    const size_t  es              = ggml_element_size(conv_states_all);
+
+    ggml_tensor * conv_state_x = ggml_view_3d(ctx0, conv_state_all, d_conv - 1, 3*d_inner, n_seqs,
+        (d_conv - 1) * ggml_element_size(conv_state_all), n_embd_r_total * ggml_element_size(conv_state_all), 0);
+
+    // [n_seq_tokens, 3*d_inner, n_seqs]: the strided reads of the transposed views are cheap for a few tokens
+    ggml_tensor * x_t[3];
+    for (int i = 0; i < 3; ++i) {
+        ggml_tensor * x_proj = ggml_mul_mat(ctx0, proj_w[i], x);
+        x_t[i] = ggml_transpose(ctx0, ggml_reshape_3d(ctx0, x_proj, d_inner, n_seq_tokens, n_seqs));
+    }
+    ggml_tensor * x_all  = ggml_concat(ctx0, ggml_concat(ctx0, x_t[0], x_t[1], 1), x_t[2], 1);
+    ggml_tensor * conv_x = ggml_concat(ctx0, conv_state_x, x_all, 0); // [d_conv - 1 + n_seq_tokens, 3*d_inner, n_seqs]
+
+    // rollback groups, see glm5_conv1d
+    const int64_t n_groups = std::min<int64_t>(K_rs, n_seq_tokens);
+    for (int64_t s = 0; s < n_groups; ++s) {
+        const int64_t s_idx = n_seq_tokens - s;
+        ggml_tensor * conv_x_s = ggml_view_3d(ctx0, conv_x, d_conv - 1, 3*d_inner, n_seqs,
+            conv_x->nb[1], conv_x->nb[2], s_idx * conv_x->nb[0]);
+        ggml_build_forward_expand(gf,
+            ggml_cpy(ctx0, conv_x_s,
+                ggml_view_3d(ctx0, conv_states_all, d_conv - 1, 3*d_inner, n_seqs,
+                    (d_conv - 1) * es, n_embd_r_total * es, (s * mem_size + kv_head) * n_embd_r_total * es)));
+    }
+
+    for (int i = 0; i < 3; ++i) {
+        ggml_tensor * conv_x_i = ggml_view_3d(ctx0, conv_x, conv_x->ne[0], d_inner, n_seqs,
+            conv_x->nb[1], conv_x->nb[2], i * d_inner * conv_x->nb[1]);
+        ggml_tensor * Xcur = ggml_ssm_conv(ctx0, conv_x_i, ggml_reshape_2d(ctx0, conv_w[i], d_conv, d_inner));
+        Xcur = ggml_silu(ctx0, Xcur);
+        out[i] = ggml_reshape_4d(ctx0, Xcur, head_dim, n_head, n_seq_tokens, n_seqs);
+    }
+}
