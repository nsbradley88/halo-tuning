+// glm5-next small-ubatch KDA conv: Q/K/V conv windows concatenated once, three SSM_CONV(+SILU) on channel views
+struct test_glm5_conv_qkv : public test_case {
+    const int64_t d_inner;
+    const int64_t n_seq_tokens;
+    const int64_t n_seqs;
+
+    std::string vars() override {
+        return VARS_TO_STR3(d_inner, n_seq_tokens, n_seqs);
+    }
+
+    test_glm5_conv_qkv(int64_t d_inner = 256, int64_t n_seq_tokens = 3, int64_t n_seqs = 1)
+        : d_inner(d_inner), n_seq_tokens(n_seq_tokens), n_seqs(n_seqs) {}
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "GLM5_CONV_QKV";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t d_conv = 4;
+        ggml_tensor * state = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, d_conv - 1, 3*d_inner, n_seqs);
+        ggml_tensor * x_t[3];
+        ggml_tensor * w[3];
+        for (int i = 0; i < 3; ++i) {
+            ggml_tensor * x = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, d_inner, n_seq_tokens, n_seqs);
+            x_t[i] = ggml_transpose(ctx, x);
+            w[i]   = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_conv, d_inner);
+        }
+        ggml_tensor * x_all  = ggml_concat(ctx, ggml_concat(ctx, x_t[0], x_t[1], 1), x_t[2], 1);
+        ggml_tensor * conv_x = ggml_concat(ctx, state, x_all, 0);
+        ggml_tensor * out = nullptr;
+        for (int i = 0; i < 3; ++i) {
+            ggml_tensor * xi = ggml_view_3d(ctx, conv_x, conv_x->ne[0], d_inner, n_seqs,
+                    conv_x->nb[1], conv_x->nb[2], i * d_inner * conv_x->nb[1]);
+            ggml_tensor * y = ggml_silu(ctx, ggml_ssm_conv(ctx, xi, w[i]));
+            out = out ? ggml_concat(ctx, out, y, 0) : y;
+        }
+        // the rollback windows
+        ggml_tensor * win = ggml_cont(ctx, ggml_view_3d(ctx, conv_x, d_conv - 1, 3*d_inner, n_seqs,
+                conv_x->nb[1], conv_x->nb[2], n_seq_tokens * conv_x->nb[0]));
+        return ggml_concat(ctx, ggml_reshape_1d(ctx, out, ggml_nelements(out)), ggml_reshape_1d(ctx, win, ggml_nelements(win)), 0);
+    }
+};
