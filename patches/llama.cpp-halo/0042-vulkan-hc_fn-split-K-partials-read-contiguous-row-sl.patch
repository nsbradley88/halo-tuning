diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_mix_partials.comp b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_mix_partials.comp
index f55919f31..159a6ad5d 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_mix_partials.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/dsv4_hc_mix_partials.comp
@@ -2,111 +2,119 @@
 
 #extension GL_EXT_control_flow_attributes : require
 #extension GL_EXT_shader_16bit_storage : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
 
 #include "types.glsl"
 
-// Split-K hc_fn matvec for few tokens (q8_0 weights, m <= 31 rows). Workgroup (p, g) multiplies the K slice p of
-// SLICE_BLOCKS*32 elements with tokens g*NT .. g*NT+NT-1 and writes
-//   dst[i, t, p] = sum over the slice of hc_fn[:, i] * x[:, t]    for i < m
-//   dst[m, t, p] = sum over the slice of x[:, t]^2
-//   dst[i, t, p] = 0                                              for m < i < 32
-// ggml_dsv4_hc_pre_mix sums the slices. Per block: sum(q*x) * d, then the blocks of the slice in order.
+// Split-K hc_fn matvec for few tokens (q8_0 weights, m <= 31 rows). K is cut into n_split contiguous slices;
+// workgroup (s, row, g) reduces slice s of one weight row (a contiguous run of the row, good for DRAM) against
+// tokens g*NT .. g*NT+NT-1, so the grid has n_split*(m+1) workgroups instead of one per row. It writes
+//   dst[row, t, s] = sum over slice s of hc_fn[:, row] * x[:, t]    for row < m
+//   dst[m,   t, s] = sum over slice s of x[:, t]^2                  (workgroups with row == m, which also zero m+1..31)
+// ggml_dsv4_hc_pre_mix sums the slices.
 
 layout(constant_id = 0) const uint BLOCK_SIZE = 256;
+layout(constant_id = 1) const uint SUBGROUP_SIZE = 32;
 layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 
-const uint QK          = 32;
-const uint SLICE_BLOCKS = 16;
-const uint SLICE       = SLICE_BLOCKS * QK;
-const uint NT          = 8;
-const uint MAX_M       = 31;
-const uint TAIL        = 32;
+const uint QK   = 32;
+const uint NT   = 8;
+const uint TAIL = 32;
+const uint N_SUBGROUPS = BLOCK_SIZE / SUBGROUP_SIZE;
 
 layout(push_constant) uniform parameter
 {
     uint m;
     uint k;           // elements per row of hc_fn = elements per token of x
     uint n_tokens;
-    uint n_split;     // k / SLICE
-    uint a_offset;    // blocks
-    uint x_offset;    // floats
+    uint n_split;
+    uint a_offset;    // q8_0 blocks
+    uint x_offset;    // floats, 16-byte aligned
     uint d_offset;    // floats
 };
 
-layout(binding = 0, std430) readonly buffer A { block_q8_0 data_a[]; };
-layout(binding = 1, std430) readonly buffer X { float data_x[]; };
+layout(binding = 0, std430) readonly buffer A { block_q8_0_packed16 data_a[]; };
+layout(binding = 1, std430) readonly buffer X { vec4 data_x4[]; };
 layout(binding = 2, std430) writeonly buffer D { float data_d[]; };
 
-shared float xs[NT * SLICE];
-shared float part[MAX_M * SLICE_BLOCKS * NT];
-shared float sq[NT * 32];
+shared float red[NT * N_SUBGROUPS];
 
 void main() {
     const uint tid = gl_LocalInvocationID.x;
-    const uint p   = gl_WorkGroupID.x;
-    const uint t0  = gl_WorkGroupID.y * NT;
+    const uint s   = gl_WorkGroupID.x;
+    const uint row = gl_WorkGroupID.y;
+    const uint t0  = gl_WorkGroupID.z * NT;
     const uint nt  = min(NT, n_tokens - t0);
-    const uint k0  = p * SLICE;
 
-    for (uint idx = tid; idx < NT * SLICE; idx += BLOCK_SIZE) {
-        const uint t = idx / SLICE;
-        const uint j = idx % SLICE;
-        xs[idx] = t < nt ? data_x[x_offset + (t0 + t) * k + k0 + j] : 0.0f;
-    }
-    barrier();
+    const uint nb     = k / QK;          // blocks per row
+    const uint sbk    = nb / n_split;    // blocks per slice
+    const uint b0     = s * sbk;
 
-    // partial sums of squares: 32 invocations per token
-    for (uint idx = tid; idx < NT * 32; idx += BLOCK_SIZE) {
-        const uint t = idx / 32;
-        const uint l = idx % 32;
-        float s = 0.0f;
-        for (uint j = l; j < SLICE; j += 32) {
-            const float v = xs[t * SLICE + j];
-            s = fma(v, v, s);
-        }
-        sq[idx] = s;
+    float acc[NT];
+    [[unroll]] for (uint t = 0; t < NT; ++t) {
+        acc[t] = 0.0f;
     }
 
-    // one (row, block) unit per invocation and round
-    const uint nb_row = k / QK;
-    for (uint u = tid; u < m * SLICE_BLOCKS; u += BLOCK_SIZE) {
-        const uint row = u / SLICE_BLOCKS;
-        const uint b   = u % SLICE_BLOCKS;
-        const uint ib  = a_offset + row * nb_row + p * SLICE_BLOCKS + b;
-        const float d  = float(data_a[ib].d);
+    // half blocks of 16 weights: 8 int16 words of int8 pairs, 4 vec4 of x per token
+    for (uint h = tid; h < 2 * sbk; h += BLOCK_SIZE) {
+        const uint b    = b0 + h / 2;
+        const uint hb = h % 2;
+        const uint xb   = (x_offset + b * QK + hb * 16) / 4;
 
-        float acc[NT];
-        [[unroll]] for (uint t = 0; t < NT; ++t) {
-            acc[t] = 0.0f;
-        }
-        [[unroll]] for (uint j = 0; j < QK; ++j) {
-            const float q = float(data_a[ib].qs[j]);
+        if (row < m) {
+            const uint ib = a_offset + row * nb + b;
+            const float d = float(data_a[ib].d);
+            float q[16];
+            [[unroll]] for (uint w = 0; w < 8; ++w) {
+                const int v = int(data_a[ib].qs[hb * 8 + w]);
+                q[2 * w    ] = float(bitfieldExtract(v, 0, 8));
+                q[2 * w + 1] = float(bitfieldExtract(v, 8, 8));
+            }
+            [[unroll]] for (uint t = 0; t < NT; ++t) {
+                if (t < nt) {
+                    float sum = 0.0f;
+                    [[unroll]] for (uint c = 0; c < 4; ++c) {
+                        const vec4 xv = data_x4[xb + (t0 + t) * (k / 4) + c];
+                        sum = fma(q[4 * c    ], xv.x, sum);
+                        sum = fma(q[4 * c + 1], xv.y, sum);
+                        sum = fma(q[4 * c + 2], xv.z, sum);
+                        sum = fma(q[4 * c + 3], xv.w, sum);
+                    }
+                    acc[t] = fma(sum, d, acc[t]);
+                }
+            }
+        } else {
             [[unroll]] for (uint t = 0; t < NT; ++t) {
-                acc[t] = fma(q, xs[t * SLICE + b * QK + j], acc[t]);
+                if (t < nt) {
+                    [[unroll]] for (uint c = 0; c < 4; ++c) {
+                        const vec4 xv = data_x4[xb + (t0 + t) * (k / 4) + c];
+                        acc[t] += dot(xv, xv);
+                    }
+                }
             }
         }
-        [[unroll]] for (uint t = 0; t < NT; ++t) {
-            part[(row * SLICE_BLOCKS + b) * NT + t] = acc[t] * d;
+    }
+
+    // workgroup reduction per token
+    [[unroll]] for (uint t = 0; t < NT; ++t) {
+        const float v = subgroupAdd(acc[t]);
+        if (gl_SubgroupInvocationID == 0) {
+            red[t * N_SUBGROUPS + gl_SubgroupID] = v;
         }
     }
     barrier();
 
-    for (uint w = tid; w < TAIL * NT; w += BLOCK_SIZE) {
-        const uint i = w / NT;
-        const uint t = w % NT;
-        if (t >= nt) {
-            continue;
-        }
-        float s = 0.0f;
-        if (i < m) {
-            [[unroll]] for (uint b = 0; b < SLICE_BLOCKS; ++b) {
-                s += part[(i * SLICE_BLOCKS + b) * NT + t];
-            }
-        } else if (i == m) {
-            for (uint l = 0; l < 32; ++l) {
-                s += sq[t * 32 + l];
-            }
+    if (tid < nt) {
+        float sum = 0.0f;
+        [[unroll]] for (uint i = 0; i < N_SUBGROUPS; ++i) {
+            sum += red[tid * N_SUBGROUPS + i];
         }
-        data_d[d_offset + (p * n_tokens + t0 + t) * TAIL + i] = s;
+        data_d[d_offset + (s * n_tokens + t0 + tid) * TAIL + row] = sum;
+    } else if (row == m && tid >= NT && tid < NT + nt * (TAIL - m - 1)) {
+        const uint w = tid - NT;
+        const uint t = w / (TAIL - m - 1);
+        const uint i = m + 1 + w % (TAIL - m - 1);
+        data_d[d_offset + (s * n_tokens + t0 + t) * TAIL + i] = 0.0f;
     }
 }
