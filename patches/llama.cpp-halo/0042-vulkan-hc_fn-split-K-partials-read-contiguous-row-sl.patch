+    for (uint idx = tid; idx < nm * n_split; idx += BLOCK_SIZE) {
+        const uint p = idx / nm;
+        const uint i = idx % nm;
+        ptmp[idx] = data_m[m_offset + i * nbm0 + it * nbm1 + p * nbm2];
+    }
+    barrier();
+    if (tid < nm) {
         float acc = 0.0f;
         for (uint p = 0; p < n_split; ++p) {
-            acc += data_m[m_offset + tid * nbm0 + it * nbm1 + p * nbm2];
+            acc += ptmp[p * nm + tid];
         }
         msum[tid] = acc;
     }
