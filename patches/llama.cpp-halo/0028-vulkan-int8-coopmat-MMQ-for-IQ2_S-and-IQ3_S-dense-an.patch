 }
 
+#elif defined(DATA_A_IQ3_S)
+
+// One thread per 32-value sub-block (LOAD_VEC_A 32): 8 grid indices (9 bits, 4 magnitudes 1..15 each), 32 sign bits,
+// one scale. Whole-sub-block loads keep each row's reads in one place (4 threads x 8 values made 14 scattered
+// 2-byte loads per sub-block and were load-bound).
+struct block_a_prefetch {
+    uvec4 qs;        // 8 low index bytes as 4 x u16
+    uint32_t signs;
+    uint32_t qh_sc;  // qh byte | scale << 8
+    float d;
+};
+
+block_a_prefetch block_a_load(uint ib, uint loadr) {
+    block_a_prefetch blk;
+    const uint ib_k = ib / 8;
+    const uint ib32 = ib % 8;
+    blk.qs = uvec4(data_a_packed16[ib_k].qs[ib32 * 4    ], data_a_packed16[ib_k].qs[ib32 * 4 + 1],
+                   data_a_packed16[ib_k].qs[ib32 * 4 + 2], data_a_packed16[ib_k].qs[ib32 * 4 + 3]);
+    blk.signs = pack32(u16vec2(data_a_packed16[ib_k].signs[ib32 * 2], data_a_packed16[ib_k].signs[ib32 * 2 + 1]));
+    const uint qh = (uint(data_a_packed16[ib_k].qh[ib32 / 2]) >> ((ib32 & 1) * 8)) & 0xFF;
+    const uint sc = (uint(data_a_packed16[ib_k].scales[ib32 / 4]) >> ((ib32 & 3) * 4)) & 0xF;
+    blk.qh_sc = qh | (sc << 8);
+    blk.d = float(data_a_packed16[ib_k].d);
+    return blk;
+}
+
+void block_a_to_shmem(block_a_prefetch blk, uint buf_ib, uint ks, uint loadr) {
+    [[unroll]] for (uint l = 0; l < 4; l++) {
+        const uint qs = blk.qs[l];
+        const uint qh = blk.qh_sc >> (2 * l);
+        const uint signs = blk.signs >> (8 * l);
+        const ivec4 vals0 = ivec4(unpack8(iq3s_grid[( qs       & 0xFF) | ((qh & 1) << 8)]));
+        const ivec4 vals1 = ivec4(unpack8(iq3s_grid[((qs >> 8) & 0xFF) | ((qh & 2) << 7)]));
+        const ivec4 m0 = -(ivec4(signs,      signs >> 1, signs >> 2, signs >> 3) & 1);
+        const ivec4 m1 = -(ivec4(signs >> 4, signs >> 5, signs >> 6, signs >> 7) & 1);
+        buf_a_qs[buf_ib * QPITCH + ks * (BK / 4) + l * 2    ] = pack32(i8vec4((vals0 ^ m0) - m0));
+        buf_a_qs[buf_ib * QPITCH + ks * (BK / 4) + l * 2 + 1] = pack32(i8vec4((vals1 ^ m1) - m1));
+    }
+    buf_a_d[ks * BM + buf_ib] = blk.d * float(1 + 2 * ((blk.qh_sc >> 8) & 0xF));
+}
+
+#elif defined(DATA_A_IQ2_S)
+
+// One thread per 32-value sub-block (LOAD_VEC_A 32): 4 grid indices (10 bits, 8 magnitudes 8/25/43 each),
+// 4 sign bytes, two scales (one per 16 values).
+struct block_a_prefetch {
+    uint32_t qs;     // 4 low index bytes
+    uint32_t signs;  // 4 sign bytes
+    uint32_t qh_sc;  // qh byte | scales byte << 8
+    float d;
+};
+
+block_a_prefetch block_a_load(uint ib, uint loadr) {
+    block_a_prefetch blk;
+    const uint ib_k = ib / 8;
+    const uint ib32 = ib % 8;
+    blk.qs    = pack32(u16vec2(data_a_packed16[ib_k].qs[2 * ib32],      data_a_packed16[ib_k].qs[2 * ib32 + 1]));
+    blk.signs = pack32(u16vec2(data_a_packed16[ib_k].qs[16 + 2 * ib32], data_a_packed16[ib_k].qs[16 + 2 * ib32 + 1]));
+    const uint qh = (uint(data_a_packed16[ib_k].qh[ib32 / 2])     >> ((ib32 & 1) * 8)) & 0xFF;
+    const uint sc = (uint(data_a_packed16[ib_k].scales[ib32 / 2]) >> ((ib32 & 1) * 8)) & 0xFF;
+    blk.qh_sc = qh | (sc << 8);
+    blk.d = float(data_a_packed16[ib_k].d);
+    return blk;
+}
+
+void block_a_to_shmem(block_a_prefetch blk, uint buf_ib, uint ks, uint loadr) {
+    [[unroll]] for (uint l = 0; l < 4; l++) {
+        const uint idx = ((blk.qs >> (8 * l)) & 0xFF) | (((blk.qh_sc & 0xFF) << (8 - 2 * l)) & 0x300);
+        const uvec2 g = iq2s_grid[idx];
+        const uint signs = blk.signs >> (8 * l);
+        const ivec4 vals0 = ivec4(unpack8(g.x));
+        const ivec4 vals1 = ivec4(unpack8(g.y));
+        const ivec4 m0 = -(ivec4(signs,      signs >> 1, signs >> 2, signs >> 3) & 1);
+        const ivec4 m1 = -(ivec4(signs >> 4, signs >> 5, signs >> 6, signs >> 7) & 1);
+        buf_a_qs[buf_ib * QPITCH + ks * (BK / 4) + l * 2    ] = pack32(i8vec4((vals0 ^ m0) - m0));
+        buf_a_qs[buf_ib * QPITCH + ks * (BK / 4) + l * 2 + 1] = pack32(i8vec4((vals1 ^ m1) - m1));
+    }
+    const uint sc = blk.qh_sc >> 8;
+    buf_a_d[(ks * KSCALES    ) * BM + buf_ib] = blk.d * (0.5 + float(sc & 0xF)) * 0.25;
+    buf_a_d[(ks * KSCALES + 1) * BM + buf_ib] = blk.d * (0.5 + float(sc >> 4))  * 0.25;
+}
+
 #elif defined(DATA_A_NVFP4)
 
 struct block_a_prefetch {
