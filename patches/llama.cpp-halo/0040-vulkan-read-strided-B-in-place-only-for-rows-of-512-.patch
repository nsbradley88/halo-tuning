From 8214942bd991c420fae9c4e1a488d72bac6bde19 Mon Sep 17 00:00:00 2001
From: nsbradley88 <3960699+nsbradley88@users.noreply.github.com>
Date: Tue, 13 Oct 2026 10:50:20 +0000
Subject: [PATCH 40/46] vulkan: read strided B in place only for rows of >= 512
 elements

Cold timings (Radeon 8060S): MLA wv_b (k=512) strided 46.8 vs copied 49.9 us at n=3 and 42.6 vs 44.6 at n=1;
MLA wk_b (k=256) copied 55.3 vs strided 58.5 us at n=3, 45.4 vs 48.1 at n=1.
GGML_VK_MMV_STRIDED_Y_MIN_COLS sets the column threshold (default 1).

halo port: GLM patch 0018 (default-on RDNA3 large-workgroup rule) is not ported; q27-tune keeps that rule as
off-by-default knobs (GGML_VK_DMMV_LARGE_MAX_M=1024 GGML_VK_DMMV_LARGE_MIN_K=8192 reproduce it), so this
commit only adds the strided-B row-length rule.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-vulkan/ggml-vulkan-types.h | 1 +
 ggml/src/ggml-vulkan/ggml-vulkan.cpp     | 4 ++++
 2 files changed, 5 insertions(+)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan-types.h b/ggml/src/ggml-vulkan/ggml-vulkan-types.h
index 4a27f5ce9..65d676787 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan-types.h
+++ b/ggml/src/ggml-vulkan/ggml-vulkan-types.h
@@ -1021,6 +1021,7 @@ struct vk_device_struct {
     uint32_t dmmv_large_min_k;  // AMD: ... or m <= 4096 and k >= this (n <= 3)
     bool     dmmv_large_force;  // experiment: large workgroup for every matvec
     bool     disable_batched_mmv; // GGML_VK_DISABLE_BATCHED_MMV: no mul_mat_vec for 2-4 columns with batches
+    uint32_t mmv_strided_y_min_cols; // GGML_VK_MMV_STRIDED_Y_MIN_COLS
     bool disable_descriptor_reuse;
     std::atomic<uint64_t> buffer_destroy_count {};
     bool disable_host_visible_vidmem;
diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index cd25ae35a..03c4363a3 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -5021,6 +5021,9 @@ vk_device ggml_vk_get_device(size_t idx) {
         device->dmmv_large_min_k = getenv("GGML_VK_DMMV_LARGE_MIN_K") ? (uint32_t) std::stoul(getenv("GGML_VK_DMMV_LARGE_MIN_K")) : UINT32_MAX;
         device->dmmv_large_force = getenv("GGML_VK_DMMV_LARGE_FORCE") != nullptr;
         device->disable_batched_mmv = getenv("GGML_VK_DISABLE_BATCHED_MMV") != nullptr;
+        // read strided f32 B in place (rows of >= 512 elements) from this many columns on; shorter rows were faster
+        // through the contiguous copy (MLA wk_b k=256: 55.3 vs 58.5 us at n=3, wv_b k=512: 49.9 vs 46.8 us)
+        device->mmv_strided_y_min_cols = getenv("GGML_VK_MMV_STRIDED_Y_MIN_COLS") ? (uint32_t) std::stoul(getenv("GGML_VK_MMV_STRIDED_Y_MIN_COLS")) : 1;
 
         device->disable_descriptor_reuse = getenv("GGML_VK_DISABLE_DESCRIPTOR_REUSE") != nullptr;
 
@@ -6917,6 +6920,7 @@ static void ggml_vk_mul_mat_vec_q_f16(ggml_backend_vk_context * ctx, vk_context&
     // instead of copying it to a contiguous buffer first.
     const size_t y_ts = ggml_type_size(src1->type);
     const bool y_strided = y_non_contig && !widen_bf16 && !swap_inputs && src1->type == GGML_TYPE_F32 &&
+                           ne11 >= ctx->device->mmv_strided_y_min_cols && ne10 >= 512 &&
                            src1->nb[0] == y_ts && ne10 % 4 == 0 &&
                            src1->nb[1] % (4 * y_ts) == 0 && src1->nb[2] % (4 * y_ts) == 0 &&
                            (ne13 == 1 || src1->nb[3] == src1->nb[2] * ne12) &&
