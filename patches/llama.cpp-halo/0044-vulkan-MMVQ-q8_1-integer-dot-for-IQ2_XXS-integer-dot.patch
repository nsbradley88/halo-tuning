@@ -585,7 +585,7 @@ FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
 }
 #endif
 
-#if defined(DATA_A_IQ3_S) || defined(DATA_A_IQ3_XXS) || defined(DATA_A_IQ2_S) || defined(DATA_A_IQ2_XS)
+#if defined(DATA_A_IQ3_S) || defined(DATA_A_IQ3_XXS) || defined(DATA_A_IQ2_S) || defined(DATA_A_IQ2_XS) || defined(DATA_A_IQ2_XXS)
 // grid bytes g (all >= 1) with the 4 sign bits s applied: byte-wise two's complement negation, no carries
 int32_t iq3_signed_grid(const uint g, const uint s) {
     const uint m = ((s & 0xF) * 0x00204081u) & 0x01010101u; // sign bit i -> bit 0 of byte i
@@ -694,3 +694,27 @@ FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
     return FLOAT_TYPE(float(cache_b_ds.x) * d * 0.25 * sum);
 }
 #endif
+
+#if defined(DATA_A_IQ2_XXS)
+FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
+    const uint ib = ib_a / 8;
+    const uint ib32 = ib_a % 8;
+
+    // 4 x 8-bit grid indices, then 4 x 7 sign bits (the 8th is the parity) and the 4-bit scale of this 32-value group
+    const uint qi = uint(data_a_packed16[ib].qs[4 * ib32    ]) | (uint(data_a_packed16[ib].qs[4 * ib32 + 1]) << 16);
+    const uint ss = uint(data_a_packed16[ib].qs[4 * ib32 + 2]) | (uint(data_a_packed16[ib].qs[4 * ib32 + 3]) << 16);
+
+    int32_t q_sum = 0;
+    [[unroll]] for (uint l = 0; l < 4; ++l) {
+        uint s = bitfieldExtract(ss, 7 * int(l), 7);
+        s |= (bitCount(s) & 1) << 7;
+        const uvec2 g = iq2xxs_grid[(qi >> (8 * l)) & 0xFF];
+        q_sum += dotPacked4x8EXT(iq3_signed_grid(g.x, s     ), cache_b_qs[2 * l    ]);
+        q_sum += dotPacked4x8EXT(iq3_signed_grid(g.y, s >> 4), cache_b_qs[2 * l + 1]);
+    }
+
+    const float d = float(data_a_packed16[ib].d) * (0.5 + float(ss >> 28)) * 0.25;
+
+    return FLOAT_TYPE(float(cache_b_ds.x) * d * float(q_sum));
+}
+#endif
