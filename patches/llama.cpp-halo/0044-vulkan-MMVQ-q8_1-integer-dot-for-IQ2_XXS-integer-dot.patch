diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index b7f0d50d4..22fdbdc52 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -5847,6 +5847,64 @@ struct test_mul_mat_id : public test_case {
     }
 };
 
+// MUL_MAT_ID for perf at real MoE sizes: quantizing hundreds of MB of IQ weights on the CPU takes minutes, so the
+// expert weights are random bytes (timing only, the values are meaningless; use test_mul_mat_id for correctness)
+struct test_mul_mat_id_fast : public test_mul_mat_id {
+    int pool = 0; // > 0: every token draws its experts from one random pool of this many experts (consecutive tokens
+                  // share most experts in practice: a 3-token verify routes to ~10 distinct experts, not 24)
+
+    test_mul_mat_id_fast(ggml_type type_a, ggml_type type_b, int n_mats, int n_used, bool b, int64_t m, int64_t n, int64_t k, int pool = 0)
+        : test_mul_mat_id(type_a, type_b, n_mats, n_used, b, m, n, k), pool(pool) {}
+
+    std::string vars() override { return test_mul_mat_id::vars() + ",fast=1,pool=" + std::to_string(pool); }
+
+    void init_ids(ggml_context * ctx) {
+        if (pool == 0) {
+            init_mul_mat_id_ids(ctx, n_mats);
+            return;
+        }
+        static std::default_random_engine rng(7);
+        std::vector<int32_t> all(n_mats);
+        for (int i = 0; i < n_mats; i++) { all[i] = i; }
+        std::shuffle(all.begin(), all.end(), rng);
+        std::vector<int32_t> pl(all.begin(), all.begin() + pool);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type != GGML_TYPE_I32 || ggml_is_view_op(t->op)) {
+                continue;
+            }
+            for (int64_t r = 0; r < ggml_nrows(t); r++) {
+                std::vector<int32_t> data(t->ne[0]);
+                std::shuffle(pl.begin(), pl.end(), rng);
+                for (int i = 0; i < t->ne[0]; i++) {
+                    data[i] = i < pool ? pl[i] : all[i % n_mats]; // only the first n_used <= pool are read
+                }
